---
import '../styles/global.css'
interface Props { title: string; description?: string }
const { title, description = 'Family medicine and pediatrics for every age, at two offices in Elmhurst and Hicksville.' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-dvh">
    <slot />
    <script>
      // Scroll reveal (pattern from 02-analysis/base-site-css-js-dissection-2026-11-01.md, section 5).
      // Content is visible without JS: the hidden start state only applies under html.js. Reduced motion: skipped.
      const root = document.documentElement
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const targets = document.querySelectorAll<HTMLElement>('main section:not(#hero) :is(h2, [data-reveal], .lift, figure, details)')
        root.classList.add('js')
        const io = new IntersectionObserver(entries => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) }
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' })
        targets.forEach(el => {
          const siblings = el.parentElement ? [...el.parentElement.children] : []
          el.style.setProperty('--rd', `${Math.min(siblings.indexOf(el), 4) * 70}ms`)
          el.classList.add('reveal'); io.observe(el)
        })
        setTimeout(() => targets.forEach(el => el.classList.add('in')), 4000) // never leave content hidden
      }
    </script>
  </body>
</html>
