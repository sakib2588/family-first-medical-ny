---
import '../styles/global.css'
interface Props { title: string; description?: string }
const { title, description = 'Demo design of a family medicine and pediatrics practice website.' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-dvh">
    <aside aria-label="Demo notice" class="bg-indigo px-4 py-1.5 text-center text-xs tracking-wide text-white">Design demo · sample content</aside>
    <slot />
  </body>
</html>
