---
// Shared page shell: header, main, footer, sticky bar and the call dialog. Every page uses this.
import Base from './Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/home/Footer.astro'
import StickyBar from '../components/StickyBar.astro'
import CallDialog from '../components/CallDialog.astro'
import BackToTop from '../components/BackToTop.astro'
// closing: the footer's closing call to action. Home turns it off: its request form sits right above (Gate 9 item 6).
interface Props { title: string; description?: string; closing?: boolean }
const { title, description, closing = true } = Astro.props
---
<Base title={title} description={description}>
  <Header />
  <main id="main"><slot /></main>
  <Footer closing={closing} />
  <StickyBar />
  <BackToTop />
  <CallDialog />
</Base>
