---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import Section from '../../components/Section.astro'
import OfficeCard from '../../components/OfficeCard.astro'
import { offices } from '../../data/practice'
---
<Page title="Locations | AIMSS Family Health" description="Two offices: Elmhurst, Queens and Hicksville, Long Island.">
  <PageHead title="Two offices, one team" lead="Call the office you plan to visit. Each office has its own hours and phone." crumbs={[['Locations', '/locations']]} />
  <Section tone="white" label="Our offices">
    <ul class="grid gap-4 lg:grid-cols-2 lg:gap-6">
      {offices.map(o => (<li class="flex"><OfficeCard office={o} /></li>))}
    </ul>
  </Section>
</Page>
