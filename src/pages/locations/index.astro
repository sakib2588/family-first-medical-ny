---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import OpenNow from '../../components/OpenNow.astro'
import { offices, telHref, mapsHref } from '../../data/practice'
---
<Page title="Locations | AIMSS Family Health" description="Two offices: Elmhurst, Queens and Hicksville, Long Island.">
  <PageHead title="Two offices, one team" lead="Call the office you plan to visit. Each office has its own hours and phone." crumbs={[['Locations', '/locations']]} />
  <section class="px-5 pb-16 md:px-8 md:pb-24"><ul class="mx-auto grid max-w-[1160px] gap-5 md:grid-cols-2 md:gap-8">
    {offices.map(o => (
      <li class="rounded-3xl bg-white p-6 md:p-8">
        <h2 class="text-2xl"><a href={`/locations/${o.slug}`} class="underline-offset-4 hover:underline">{o.name}</a></h2>
        <p class="mt-3">{o.addr}</p>
        <p class="tabular mt-2 text-muted"><OpenNow office={o} /></p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 md:max-w-lg">
          <a href={telHref(o.phone)} class="btn btn-primary inline-flex min-h-12 items-center justify-center rounded-full bg-teal-deep font-semibold text-white hover:bg-teal-darker"><span class="tabular">Call {o.phone}</span></a>
          <a href={mapsHref(o.addr)} target="_blank" rel="noopener" aria-label={`Directions to the ${o.name} (opens Google Maps)`} class="btn inline-flex min-h-12 items-center justify-center rounded-full border-2 border-line font-semibold text-indigo hover:border-indigo">Directions</a>
        </div>
      </li>
    ))}
  </ul></section>
</Page>
