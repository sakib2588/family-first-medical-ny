---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import OpenNow from '../../components/OpenNow.astro'
import Icon from '../../components/Icon.astro'
import FactSlot from '../../components/FactSlot.astro'
import { offices, doctors, officeBySlug, telHref, mapsHref, weekSummary } from '../../data/practice'
export function getStaticPaths() { return offices.map(o => ({ params: { slug: o.slug } })) }
const o = officeBySlug(Astro.params.slug!)!
const team = doctors.filter(d => o.doctors.includes(d.slug))
---
<Page title={`${o.neighborhood} | AIMSS Family Health`} description={`${o.name}: hours, phone, directions.`}>
  <PageHead title={`Pediatrics and family medicine in ${o.neighborhood.split(',')[0]}`} lead={o.addr} crumbs={[['Locations', '/locations'], [o.neighborhood.split(',')[0], `/locations/${o.slug}`]]} />
  <section class="px-5 pb-16 md:px-8 md:pb-24"><div class="mx-auto max-w-[1160px] md:grid md:grid-cols-2 md:gap-14">
    <div>
      <p class="tabular flex items-start gap-2 text-lg font-semibold text-indigo"><Icon name="clock" size={20} class="mt-1 shrink-0 text-teal-deep" /><OpenNow office={o} /></p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={telHref(o.phone)} class="btn btn-primary inline-flex min-h-12 items-center justify-center rounded-full bg-teal-deep px-6 font-semibold text-white hover:bg-teal-darker">Call {o.phone}</a>
        <a href={mapsHref(o.addr)} target="_blank" rel="noopener" aria-label={`Get directions to the ${o.name} (opens Google Maps)`} class="btn inline-flex min-h-12 items-center justify-center rounded-full border-2 border-line px-6 font-semibold text-indigo hover:border-indigo">Get directions</a>
        <a href="/contact" class="btn btn-primary inline-flex min-h-12 items-center justify-center rounded-full border-2 border-teal-deep px-6 font-semibold text-teal-deep hover:bg-teal-deep hover:text-white">Request a visit</a>
      </div>
      <h2 class="mt-10 text-2xl">Hours</h2>
      <dl class="tabular mt-3 divide-y divide-line rounded-2xl border border-line bg-white text-[0.97rem]">
        {weekSummary(o).map(([day, hours]) => (<div class="flex justify-between gap-4 px-4 py-3"><dt class="text-muted">{day}</dt><dd class="font-semibold text-indigo">{hours}</dd></div>))}
      </dl>
      <p class="mt-3 text-sm text-muted">Holiday hours: to be confirmed. If we are closed and it is urgent, call 911 or go to the nearest emergency room.</p>
    </div>
    <div class="mt-10 md:mt-0">
      <h2 class="text-2xl">Getting here</h2>
      <ul class="mt-3 space-y-2">{o.access.map(a => (<li class="flex items-start gap-2"><Icon name="pin" size={18} class="mt-1.5 shrink-0 text-muted" /><span><span class="font-semibold text-indigo">{a.label}:</span> <FactSlot fact={a.fact} /></span></li>))}</ul>
      <h2 class="mt-10 text-2xl">Who you will see here</h2>
      <ul class="mt-3 space-y-2">{team.map(d => (<li><a href={`/doctors/${d.slug}`} class="inline-flex min-h-11 items-center font-semibold text-teal-deep underline underline-offset-4">{d.name}, {d.role}</a></li>))}</ul>
    </div>
  </div></section>
</Page>
