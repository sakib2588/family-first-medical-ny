---
import Page from '../layouts/Page.astro'
import PageHead from '../components/PageHead.astro'
import RequestForm from '../components/RequestForm.astro'
import { offices, telHref } from '../data/practice'
---
<Page title="Contact and request a visit | AIMSS Family Health" description="Request a visit or call the office.">
  <PageHead title="Request a visit" lead="Tell us how to reach you. We will call you back within one business day to find a time." crumbs={[['Contact', '/contact']]} />
  <section id="request" class="px-5 pb-16 md:px-8 md:pb-24"><div class="mx-auto max-w-[1160px] md:grid md:grid-cols-2 md:gap-16">
    <RequestForm />
    <aside class="mt-10 rounded-3xl bg-white p-6 md:mt-0">
      <h2 class="text-2xl">Prefer to call?</h2>
      <ul class="mt-4 space-y-3">{offices.map(o => (<li><a href={telHref(o.phone)} class="tabular btn flex min-h-12 items-center justify-between rounded-full border-2 border-teal-deep px-5 font-semibold text-teal-deep hover:bg-teal-deep hover:text-white"><span>{o.neighborhood.split(',')[0]}</span><span>{o.phone}</span></a></li>))}</ul>
      <p class="mt-4 text-sm text-muted"><strong class="text-indigo">In an emergency, call 911.</strong> Please do not put symptoms or medical details in this form.</p>
    </aside>
  </div></section>
</Page>
