---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import { legalPages, practice } from '../../data/practice'
import { legal } from '../../data/legal'
export function getStaticPaths() { return legalPages.map(p => ({ params: { slug: p.slug } })) }
const meta = legalPages.find(p => p.slug === Astro.params.slug)!
const doc = legal[meta.slug]
---
<Page title={`${meta.short} | ${practice.name}`} description={`${meta.title} (draft).`}>
  <PageHead title={meta.title} crumbs={[['Legal', '/legal'], [meta.short, `/legal/${meta.slug}`]]} />
  <section class="px-5 pb-16 md:px-8 md:pb-24"><div class="mx-auto max-w-[1160px] md:grid md:grid-cols-[15rem_1fr] md:gap-14">
    <nav aria-label="On this page" class="mb-8 md:sticky md:top-28 md:mb-0 md:self-start">
      <p class="text-sm font-semibold uppercase tracking-[0.12em] text-muted">On this page</p>
      <ol class="mt-2 space-y-0.5">{doc.sections.map(s => (<li><a href={`#${s.id}`} class="inline-flex min-h-11 items-center text-[0.97rem] font-medium text-teal-deep underline underline-offset-4">{s.heading}</a></li>))}</ol>
    </nav>
    <div class="max-w-prose">
      <p class="rounded-2xl border-2 border-gold bg-white p-4 text-[0.97rem]"><strong class="text-indigo">DRAFT. Not legal advice.</strong> Pending review by counsel. Last reviewed: {practice.lastReviewed}. Items in [brackets] are not yet confirmed.</p>
      <div class="mt-6 rounded-2xl bg-lavender p-5"><h2 class="text-xl">In plain words</h2><p class="mt-2">{doc.summary}</p></div>
      {doc.sections.map(s => (<section id={s.id} class="scroll-mt-28"><h2 class="mt-10 text-2xl">{s.heading}</h2>{s.body.map(t => (<p class="mt-3">{t}</p>))}</section>))}
      {meta.slug === 'privacy' && (
        <section id="tracker-status" class="scroll-mt-28">
          <h2 class="mt-10 text-2xl">Tracker status</h2>
          <p class="mt-3">Checked at build on {new Date().toISOString().slice(0, 10)} by an automated test (<code>npm run check</code>) that fails if any page loads a file from another website.</p>
          <table class="mt-4 w-full border-collapse text-left text-[0.95rem]">
            <caption class="sr-only">Third-party tools on this website</caption>
            <thead><tr class="border-b-2 border-line"><th scope="col" class="py-2 pr-4">Tool</th><th scope="col" class="py-2">Present?</th></tr></thead>
            <tbody class="divide-y divide-line">
              {['Analytics', 'Advertising or social pixels', 'Session replay', 'Chat widget', 'Embedded map or video', 'Cookies', 'Fonts from another company'].map(t => (<tr><th scope="row" class="py-2 pr-4 font-medium text-indigo">{t}</th><td class="py-2">No</td></tr>))}
            </tbody>
          </table>
        </section>
      )}
    </div>
  </div></section>
</Page>
