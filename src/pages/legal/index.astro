---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import { legalPages, practice } from '../../data/practice'
import { legal } from '../../data/legal'
---
<Page title={`Legal and policies | ${practice.name}`} description="All policies in one place.">
  <PageHead title="Legal and policies" lead="Every policy for this practice, in plain words. All pages are drafts until counsel approves them." crumbs={[['Legal', '/legal']]} />
  <section class="px-5 pb-16 md:px-8 md:pb-24"><ul class="mx-auto grid max-w-[1160px] gap-4 md:grid-cols-2">
    {legalPages.map(p => (
      <li class="rounded-3xl bg-white p-6"><h2 class="text-xl"><a href={`/legal/${p.slug}`} class="underline-offset-4 hover:underline">{p.title}</a></h2><p class="mt-2 text-[0.97rem]">{legal[p.slug].summary}</p></li>
    ))}
  </ul></section>
</Page>
