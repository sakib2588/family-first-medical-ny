---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import Section from '../../components/Section.astro'
import Icon from '../../components/Icon.astro'
import { legalPages, practice } from '../../data/practice'
import { legal } from '../../data/legal'
---
<Page title={`Legal and policies | ${practice.name}`} description="All policies in one place.">
  <PageHead title="Legal and policies" lead="Every policy for this practice, in plain words. All pages are drafts until counsel approves them." crumbs={[['Legal', '/legal']]} />
  <Section tone="white" label="Policies">
    <ul class="grid gap-4 md:grid-cols-2 lg:gap-6">
      {legalPages.map(p => (
        <li class="lift card-soft flex flex-col p-5 lg:p-7">
          <h2 class="text-[1.35rem] leading-tight lg:text-[1.5rem]">{p.title}</h2>
          <p class="mt-2 flex-1 text-[0.97rem]">{legal[p.slug].summary}</p>
          <a href={`/legal/${p.slug}`} class="arrow-link mt-3 inline-flex min-h-11 items-center gap-1.5 self-start font-semibold text-teal-deep underline underline-offset-4">Read {p.short}<Icon name="arrow" size={18} /></a>
        </li>
      ))}
    </ul>
  </Section>
</Page>
