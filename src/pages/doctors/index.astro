---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import Section from '../../components/Section.astro'
import Icon from '../../components/Icon.astro'
import FactSlot from '../../components/FactSlot.astro'
import { doctors, practice, isShown, officeBySlug } from '../../data/practice'
---
<Page title="Our doctors | AIMSS Family Health" description="Meet the two doctors of the practice.">
  <PageHead title="Our doctors" lead="Two doctors who know your family, from a baby's first checkup to your own annual physical." crumbs={[['Doctors', '/doctors']]} />
  <Section tone="white" label="Doctors">
    <ul class="grid gap-6">
      {doctors.map((d, i) => {
        const schedule = d.schedule.filter(s => isShown(s.days))
        return (
        <li class="lift card-soft overflow-hidden lg:grid lg:grid-cols-[18rem_1fr]">
          <div class={`doc-side on-dark relative isolate flex flex-col items-center gap-3 overflow-hidden px-5 pb-5 pt-6 text-center text-on-dark lg:justify-center lg:p-6 ${i % 2 ? 'doc-side--b' : ''}`}>
            <div class="arch aspect-[3/4.2] w-36 border-[5px] border-white/40 bg-lavender shadow-[0_12px_30px_rgb(0_0_0/0.25)] lg:w-44"><img src={d.img} alt={d.alt} width="288" height="403" loading={i === 0 ? 'eager' : 'lazy'} class="size-full object-cover object-top" /></div>
            <div><span class="block font-display text-[1.5rem] font-semibold leading-none text-white">{d.ages}</span><span class="mt-1 block text-[0.72rem] font-bold uppercase tracking-[0.14em]">Ages seen</span></div>
            {practice.demo && <p class="text-[0.78rem] italic">Sample name and photo</p>}
          </div>
          <div class="p-5 lg:p-7">
            <p class="eyebrow">{d.role}</p>
            <h2 class="mt-1 text-[1.5rem] leading-tight lg:text-[1.9rem]"><a href={`/doctors/${d.slug}`} class="underline-offset-4 hover:underline">{d.name}</a></h2>
            <p class="mt-3 border-b border-line pb-4">{d.blurb}</p>
            {schedule.length > 0 && (
              <dl aria-label={`Where and when ${d.name} sees patients`} class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 lg:gap-x-6">
                {schedule.map(sc => (<div><dt class="eyebrow">{officeBySlug(sc.office)?.neighborhood.split(',')[0]}</dt><dd class="mt-0.5 text-indigo"><FactSlot fact={sc.days} /></dd></div>))}
              </dl>
            )}
            {isShown(d.languages) && (
              <dl class="mt-4"><div><dt class="eyebrow">Languages</dt><dd class="mt-0.5 text-[0.94rem] text-indigo"><FactSlot fact={d.languages} /></dd></div></dl>
            )}
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Care areas, ${d.name}`}>
              {d.careAreas.slice(0, 4).map(a => (<li class="rounded-full bg-mist px-3 py-1 text-[0.8rem] font-semibold text-teal-deep">{a}</li>))}
            </ul>
            <a href={`/doctors/${d.slug}`} class="arrow-link mt-4 inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">About {d.name}<Icon name="arrow" size={18} /></a>
          </div>
        </li>
      )})}
    </ul>
  </Section>
</Page>
