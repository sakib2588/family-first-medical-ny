---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import { doctors } from '../../data/practice'
---
<Page title="Our doctors | AIMSS Family Health" description="Meet the two doctors of the practice.">
  <PageHead title="Our doctors" lead="Two doctors who know your family, from a baby's first checkup to your own annual physical." crumbs={[['Doctors', '/doctors']]} />
  <section class="px-5 pb-16 md:px-8 md:pb-24"><ul class="mx-auto grid max-w-[1160px] gap-10 md:grid-cols-2 md:gap-14">
    {doctors.map(d => (
      <li class="grid grid-cols-[7.5rem_1fr] items-center gap-5 md:grid-cols-[11rem_1fr] md:gap-8">
        <div class="arch aspect-[3/4.2] bg-lavender"><img src={d.img} alt={d.alt} width="240" height="336" class="size-full object-cover object-top" /></div>
        <div>
          <h2 class="text-xl md:text-2xl"><a href={`/doctors/${d.slug}`} class="underline-offset-4 hover:underline">{d.name}</a></h2>
          <p class="mt-1 text-sm font-semibold text-teal-deep md:text-base">{d.role}</p>
          <p class="mt-1 text-sm text-muted">Sees: {d.ages}</p>
          <p class="mt-2 text-[0.97rem] md:text-base">{d.blurb}</p>
        </div>
      </li>
    ))}
  </ul></section>
</Page>
