---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import ActionPair from '../../components/ActionPair.astro'
import { doctors, offices, doctorBySlug } from '../../data/practice'
export function getStaticPaths() { return doctors.map(d => ({ params: { slug: d.slug } })) }
const d = doctorBySlug(Astro.params.slug!)!
const where = offices.filter(o => o.doctors.includes(d.slug))
---
<Page title={`${d.name} | AIMSS Family Health`} description={`${d.name}: ${d.role}.`}>
  <PageHead title={d.name} lead={d.role} crumbs={[['Doctors', '/doctors'], [d.name, `/doctors/${d.slug}`]]} />
  <section class="px-5 pb-16 md:px-8 md:pb-24"><div class="mx-auto max-w-[1160px] md:grid md:grid-cols-[18rem_1fr] md:gap-14">
    <div><div class="arch mx-auto aspect-[3/4.2] w-48 bg-lavender md:w-full"><img src={d.img} alt={d.alt} width="288" height="403" fetchpriority="high" class="size-full object-cover object-top" /></div><p class="mt-2 text-center text-[0.75rem] text-muted">Sample name and photo</p></div>
    <div class="mt-8 md:mt-0">
      <ActionPair />
      <dl class="mt-8 divide-y divide-line rounded-2xl border border-line bg-white text-[0.97rem]">
        <div class="flex justify-between gap-4 px-4 py-3"><dt class="text-muted">Sees</dt><dd class="text-right font-semibold text-indigo">{d.ages}</dd></div>
        <div class="flex justify-between gap-4 px-4 py-3"><dt class="text-muted">Languages</dt><dd class="text-right font-semibold text-indigo">{d.languages}</dd></div>
        <div class="flex justify-between gap-4 px-4 py-3"><dt class="text-muted">Training and board</dt><dd class="text-right font-semibold text-indigo">To be confirmed</dd></div>
      </dl>
      <h2 class="mt-10 text-2xl">About {d.name.replace('Dr. ', 'Dr. ')}</h2>
      <p class="mt-3 max-w-prose">{d.bio}</p>
      <h2 class="mt-10 text-2xl">Care areas</h2>
      <ul class="mt-3 flex flex-wrap gap-2">{d.careAreas.map(c => (<li class="rounded-full bg-lavender px-4 py-2 text-[0.95rem] font-medium text-indigo">{c}</li>))}</ul>
      <h2 class="mt-10 text-2xl">Where to see {d.name.split(' ').slice(-1)[0]}</h2>
      <ul class="mt-3 space-y-2">{where.map(o => (<li><a href={`/locations/${o.slug}`} class="inline-flex min-h-11 items-center font-semibold text-teal-deep underline underline-offset-4">{o.name}, {o.addr}</a></li>))}</ul>
      <div class="mt-10"><ActionPair /></div>
    </div>
  </div></section>
</Page>
