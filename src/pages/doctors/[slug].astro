---
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import Section from '../../components/Section.astro'
import ActionPair from '../../components/ActionPair.astro'
import FactSlot from '../../components/FactSlot.astro'
import Icon from '../../components/Icon.astro'
import { doctors, offices, doctorBySlug, isShown, officeBySlug, practice } from '../../data/practice'
export function getStaticPaths() { return doctors.map(d => ({ params: { slug: d.slug } })) }
const d = doctorBySlug(Astro.params.slug!)!
const i = doctors.findIndex(x => x.slug === d.slug)
const where = offices.filter(o => o.doctors.includes(d.slug))
const schedule = d.schedule.filter(s => isShown(s.days))
const facts = [...d.credentials, { label: 'Languages', fact: d.languages }].filter(c => isShown(c.fact))
---
<Page title={`${d.name} | AIMSS Family Health`} description={`${d.name}: ${d.role}.`}>
  <PageHead title={d.name} eyebrow={d.role} lead={`Sees ${d.ages.charAt(0).toLowerCase() + d.ages.slice(1)}.`} crumbs={[['Doctors', '/doctors'], [d.name, `/doctors/${d.slug}`]]} />
  <Section tone="white" label={d.name}>
    <div class="grid gap-6 lg:grid-cols-[19rem_1fr] lg:gap-8">
      <div class={`doc-side on-dark relative isolate flex flex-col items-center gap-4 overflow-hidden rounded-[1.25rem] px-5 pb-6 pt-7 text-center text-on-dark lg:self-start ${i % 2 ? 'doc-side--b' : ''}`}>
        <div class="arch aspect-[3/4.2] w-48 border-[5px] border-white/40 bg-lavender shadow-[0_12px_30px_rgb(0_0_0/0.25)] lg:w-56"><img src={d.img} alt={d.alt} width="288" height="403" fetchpriority="high" class="size-full object-cover object-top" /></div>
        <div><span class="block font-display text-[1.5rem] font-semibold leading-none text-white">{d.ages}</span><span class="mt-1 block text-[0.72rem] font-bold uppercase tracking-[0.14em]">Ages seen</span></div>
        {practice.demo && <p class="text-[0.78rem] italic">Sample name and photo</p>}
      </div>
      <div class="card-soft p-5 lg:p-8">
        <ActionPair />
        {(schedule.length > 0 || facts.length > 0) && (
          <dl class="mt-6 grid gap-x-6 gap-y-4 border-y border-line py-5 sm:grid-cols-2">
            {schedule.map(sc => (<div><dt class="eyebrow">{officeBySlug(sc.office)?.neighborhood.split(',')[0]}</dt><dd class="mt-0.5 text-indigo"><FactSlot fact={sc.days} /></dd></div>))}
            {facts.map(c => (<div><dt class="eyebrow">{c.label}</dt><dd class="mt-0.5 text-indigo"><FactSlot fact={c.fact} /></dd></div>))}
          </dl>
        )}
        <h2 class="mt-7 text-[1.5rem] lg:text-[1.9rem]">About {d.name}</h2>
        <p class="mt-3 max-w-prose">{d.bio}</p>
        <h2 class="mt-8 text-[1.5rem] lg:text-[1.9rem]">Care areas</h2>
        <ul class="mt-3 flex flex-wrap gap-2">{d.careAreas.map(c => (<li class="rounded-full bg-mist px-3.5 py-1.5 text-[0.9rem] font-semibold text-teal-deep">{c}</li>))}</ul>
        <h2 class="mt-8 text-[1.5rem] lg:text-[1.9rem]">Where to see {d.name}</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">{where.map(o => (<li><a href={`/locations/${o.slug}`} class="arrow-link lift flex min-h-16 items-center justify-between gap-3 rounded-2xl border border-line bg-white px-4 py-3"><span><span class="block font-semibold text-indigo">{o.name}</span><span class="block text-[0.9rem] text-muted">{o.addr}</span></span><Icon name="arrow" size={18} class="shrink-0 text-teal-deep" /></a></li>))}</ul>
      </div>
    </div>
  </Section>
</Page>
