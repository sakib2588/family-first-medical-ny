---
// One page per service (plan: workspace/02-analysis/service-pages-build-plan-2026-11-02.md).
// Order: breadcrumb + H1 -> answer + at-a-glance card with a photo -> who it is for + how to book -> doctor + both offices
// -> related services -> fixed safety line. Sections whose Fact is null render nothing; draft text only shows on preview builds.
import Page from '../../layouts/Page.astro'
import PageHead from '../../components/PageHead.astro'
import Section from '../../components/Section.astro'
import ActionPair from '../../components/ActionPair.astro'
import PhotoSlot from '../../components/PhotoSlot.astro'
import Icon from '../../components/Icon.astro'
import OfficeRow from '../../components/service/OfficeRow.astro'
import DoctorCard from '../../components/service/DoctorCard.astro'
import Subject from '../../components/service/Subject.astro'
import { offices, practice, isShown, ageBands } from '../../data/practice'
import { services, categoryBySlug, serviceBySlug, servicesOf, serviceUrl, doctorOf, serviceTitle, serviceDescription, answerOf, showText, showingDrafts, isDraft } from '../../data/services'
export function getStaticPaths() { return services.map(s => ({ params: { category: s.category, service: s.slug } })) }
const s = serviceBySlug(Astro.params.category!, Astro.params.service!)!
const cat = categoryBySlug(s.category)!
const doc = doctorOf(s)
const who = showText(s.whoFor)
const expect = showText(s.expect)
const reviewed = showText(s.reviewed)
const steps = isShown(practice.callbackSteps) ? practice.callbackSteps.value : null
const siblings = servicesOf(s.category).filter(x => x.slug !== s.slug)
const lower = s.name.charAt(0).toLowerCase() + s.name.slice(1)
const bands = ageBands.filter(b => b.doctors.includes(doc.slug))
const be = /s$/.test(s.name) ? 'are' : 'is'
---
<Page title={serviceTitle(s)} description={serviceDescription(s)}>
  <PageHead title={s.name} eyebrow={cat.name} lead={s.line} crumbs={[[cat.name, `/${cat.slug}`], [s.name, serviceUrl(s)]]} />

  <Section tone="white" label={`About ${lower}`}>
    <div class="grid gap-9 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-16">
      <div>
        <h2 class="text-[1.6rem] leading-tight lg:text-[2.1rem]">What {be} <Subject name={s.name} />?</h2>
        <p class="mt-4 max-w-[52ch] text-[1.1rem] leading-relaxed text-indigo lg:text-[1.2rem]">{answerOf(s)}</p>
        {showingDrafts && isDraft(s.answer) && <p class="mt-3 inline-block rounded-full border border-dashed border-muted px-3 py-1 text-[0.78rem] font-bold uppercase tracking-[0.1em] text-muted">Draft text, for doctor review</p>}
        <div class="mt-7"><ActionPair /></div>
      </div>
      <div class="svc-visual relative mx-auto w-full max-w-[26rem] lg:max-w-none">
        <PhotoSlot fact={s.photo} shape="arch" class="svc-photo mx-auto aspect-[4/4.6] w-full max-w-[22rem] border-[6px] border-white shadow-[0_18px_40px_-18px_rgb(23_18_58/0.45)]" width={704} height={810} eager />
        <dl class="svc-glance card-soft">
          <div><dt class="eyebrow">Ages seen</dt><dd>{doc.ages}</dd></div>
          <div><dt class="eyebrow">Doctor</dt><dd><a href={`/doctors/${doc.slug}`} class="inline-flex min-h-11 items-center text-teal-deep underline underline-offset-4">{doc.name}</a></dd></div>
          <div><dt class="eyebrow">Offices</dt><dd>Elmhurst and Hicksville</dd></div>
        </dl>
      </div>
    </div>
  </Section>

  <Section tone="cream" label={`How ${lower} works`}>
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 class="text-[1.5rem] leading-tight lg:text-[1.9rem]">Who {be} <Subject name={s.name} /> for?</h2>
          {who && <p class="mt-4 max-w-[52ch] text-[1.05rem] leading-relaxed">{who}</p>}
          <p class="eyebrow mt-6">Ages {doc.name} sees</p>
          <ul class="mt-3 grid gap-3">{bands.map(b => (<li class="lift card-soft flex items-center gap-3 p-3">
            <PhotoSlot fact={b.photo} class="size-14 shrink-0 !rounded-full" width={112} height={112} />
            <span><span class="block text-[0.78rem] font-bold uppercase tracking-[0.12em] text-teal-deep">{b.range}</span><span class="block font-display text-[1.1rem] font-semibold leading-tight text-indigo">{b.title}</span></span>
          </li>))}</ul>
        </div>
        {expect && (<div>
          <h2 class="text-[1.5rem] leading-tight lg:text-[1.9rem]">What does a visit usually include?</h2>
          <ul class="mt-4 grid gap-2">{expect.map(t => (<li class="flex gap-3"><Icon name="check" size={20} class="mt-1 shrink-0 text-teal-deep" /><span>{t}</span></li>))}</ul>
        </div>)}
        {steps && (<div>
          <h2 class="text-[1.5rem] leading-tight lg:text-[1.9rem]">How do I book <Subject name={s.name} />?</h2>
          <ol class="svc-steps mt-5">
            {steps.map((t, i) => (<li class="lift"><span class="svc-step__n" aria-hidden="true">{i + 1}</span><p>{t}</p></li>))}
          </ol>
        </div>)}
      </div>
    </Section>

  <Section tone="white" label="Doctor and offices">
    <h2 class="text-[1.5rem] leading-tight lg:text-[1.9rem]">Where can I get <Subject name={s.name} />?</h2>
    <div class="mt-6 grid gap-5 lg:grid-cols-[18rem_1fr]">
      <DoctorCard doctor={doc} />
      <ul class="grid gap-4">{offices.map(o => <OfficeRow office={o} />)}</ul>
    </div>
    <p class="svc-safety mt-6"><Icon name="phone" size={20} class="shrink-0 text-teal-deep" /><span><strong>In an emergency, call 911.</strong> To book or ask a question, call the office.</span></p>
    {reviewed && <p class="mt-4 text-[0.9rem] text-muted">Reviewed by {reviewed}.</p>}
  </Section>

  <Section tone="cream" label={`More ${cat.name.toLowerCase()} services`}>
    <h2 class="text-[1.5rem] leading-tight lg:text-[1.9rem]">More {cat.name.toLowerCase()} services</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {siblings.map(x => (<li><a href={serviceUrl(x)} class="lift card-soft arrow-link flex h-full min-h-24 items-start gap-4 p-4">
        <span class="svc-ico" aria-hidden="true"><Icon name={x.icon} size={22} /></span>
        <span class="min-w-0"><span class="block font-display text-[1.1rem] font-semibold leading-tight text-indigo">{x.name}</span><span class="mt-1 block text-[0.92rem] leading-snug text-muted">{x.line}</span></span>
      </a></li>))}
    </ul>
    <p class="mt-6"><a href={`/${cat.slug}`} class="arrow-link inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">All {cat.name.toLowerCase()} care<Icon name="arrow" size={16} /></a></p>
  </Section>
</Page>
