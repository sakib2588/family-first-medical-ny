---
// The doctor who sees a service or category: arch portrait, name, role, link to the doctor page.
import Icon from '../Icon.astro'
import type { Doctor } from '../../data/practice'
interface Props { doctor: Doctor }
const { doctor: doc } = Astro.props
---
<a href={`/doctors/${doc.slug}`} class="lift card-soft flex items-center gap-4 p-4 lg:flex-col lg:items-start lg:p-5">
  <span class="arch block aspect-[3/4.2] w-24 shrink-0 bg-lavender lg:w-32"><img src={doc.img} alt={doc.alt} width="288" height="403" loading="lazy" class="size-full object-cover object-top" /></span>
  <span><span class="block font-display text-[1.25rem] font-semibold leading-tight text-indigo">{doc.name}</span><span class="mt-1 block text-[0.92rem] text-muted">{doc.role}</span><span class="arrow-link mt-2 inline-flex min-h-11 items-center gap-1.5 text-[0.92rem] font-semibold text-teal-deep">Meet {doc.name}<Icon name="arrow" size={16} /></span></span>
</a>
