---
// Spec 4.0-4.2. Desktop (lg): a dark utility row (both numbers + open status, not sticky), then a white 80 px sticky
// header with the sample's six anchors (Our doctors, Services, All ages, Locations, Insurance, FAQ), a filled
// "Make an appointment" (opens the call dialog) and a ghost "Visit". The hero repeats the same pair.
// Below xl (1280): the menu button replaces the links. Phone: a white 64 px header, NOT sticky (the bottom sticky bar carries Make an appointment / Visit; owner answer 2), with a
// "Menu" button that opens a native <dialog> (Escape closes it, focus returns to the button). No JS: "Menu" is a
// link to the footer's #site-nav. Every target >= 44 px.
import Logo from './Logo.astro'
import OpenNow from './OpenNow.astro'
import FactSlot from './FactSlot.astro'
import Icon from './Icon.astro'
import MotionToggle from './MotionToggle.astro'
import { offices, practice, telHref, isShown } from '../data/practice'
export const nav = [
  { label: 'Doctors', href: '/#doctors' },
  { label: 'Services', href: '/#services' },
  { label: 'All ages', href: '/#care' },
  { label: 'Locations', href: '/#offices' },
  { label: 'Insurance', href: '/#insurance' },
  { label: 'FAQ', href: '/#faq' },
]
const place = (o: (typeof offices)[number]) => o.neighborhood.split(',')[0]
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-indigo">Skip to content</a>

<nav aria-label="Call an office" class="on-dark hidden bg-indigo-soft px-8 text-[0.88rem] text-on-dark lg:block">
  <div class="mx-auto flex max-w-[1160px] items-center gap-4 xl:gap-8">
    {offices.map(o => (
      <p class="flex items-center gap-2.5 whitespace-nowrap">
        <span>{place(o)}</span>
        <a href={telHref(o.phone)} class="tabular inline-flex min-h-11 items-center font-semibold text-white underline decoration-aqua decoration-2 underline-offset-4 hover:text-aqua">{o.phone}</a>
        <OpenNow office={o} />
      </p>
    ))}
    <MotionToggle compact class="ml-auto rounded-full hover:text-white" />
    <a href="#language-help" class="hidden min-h-11 items-center whitespace-nowrap underline xl:inline-flex underline-offset-4 hover:text-white">Language help</a>
  </div>
</nav>

<header class="header-bar frost border-b border-line bg-white px-5 md:px-8 lg:sticky lg:top-0 lg:z-40">
  <div class="mx-auto flex h-16 max-w-[1160px] items-center justify-between gap-3 lg:h-20">
    <Logo />
    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-7">
        {nav.map(item => (<li><a href={item.href} class="nav-link inline-flex min-h-11 items-center whitespace-nowrap font-semibold text-indigo">{item.label}</a></li>))}
      </ul>
    </nav>
    <div class="hidden items-center gap-2.5 lg:flex">
      <a href="/locations" data-call class="btn btn-primary inline-flex min-h-11 items-center gap-2 whitespace-nowrap rounded-full px-5 font-bold"><Icon name="phone" size={18} />Make an appointment</a>
      <a href="/#offices" class="btn btn-ghost hidden min-h-11 2xl:inline-flex items-center whitespace-nowrap rounded-full px-5 font-semibold">Visit</a>
    </div>
    <a href="#site-nav" id="menu-btn" aria-haspopup="dialog" class="btn inline-flex h-11 items-center gap-2 rounded-full border-[1.5px] border-line bg-white pl-3.5 pr-4 font-semibold text-indigo shadow-[0_2px_8px_rgb(23_18_58/0.06)] xl:hidden">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>Menu
    </a>
  </div>
</header>

<dialog id="menu-dialog" aria-label="Menu" class="drawer">
  <div class="flex h-14 shrink-0 items-center justify-between border-b border-line pl-5 pr-3">
    <Logo />
    <form method="dialog"><button class="btn inline-flex size-11 items-center justify-center rounded-full text-indigo hover:bg-mist" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button></form>
  </div>
  <div class="flex-1 px-5 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-1">
    <nav aria-label="Menu">
      <ul class="drawer-grid grid grid-cols-2">
        {nav.map(item => (<li><a href={item.href} class="flex min-h-[2.75rem] items-center font-display text-[1.08rem] font-medium text-indigo">{item.label}</a></li>))}
      </ul>
      <a href="/#request" class="arrow-link flex min-h-[2.75rem] items-center justify-between border-b border-line font-semibold text-teal-deep">Request a visit online<Icon name="arrow" size={18} /></a>
    </nav>
    <h2 class="mt-4 font-sans text-[0.8rem] font-semibold uppercase tracking-[0.08em] text-muted">Call an office</h2>
    <ul class="mt-2 space-y-2">
      {offices.map(o => (
        <li><a href={telHref(o.phone)} class="flex min-h-[3.4rem] items-center justify-between gap-3 rounded-[1rem] border border-line px-3.5 py-1.5 hover:border-teal-deep">
          <span class="min-w-0"><span class="block font-semibold leading-tight text-indigo">{place(o)}</span><OpenNow office={o} fallback="See hours" class="block text-[0.76rem] leading-tight text-muted" /></span>
          <span class="tabular whitespace-nowrap font-semibold text-teal-deep">{o.phone}</span>
        </a></li>
      ))}
    </ul>
    {isShown(practice.languages) && <p class="mt-3 text-[0.82rem]">Language help: <FactSlot fact={practice.languages} /></p>}
    <MotionToggle class="mt-1 -ml-1 px-1 text-[0.82rem] text-muted" />
  </div>
</dialog>
<style is:global>
  /* Header bar polish (owner review 2026-11-02): a soft shadow once the page scrolls, and the nav link of the section you
     are reading keeps its underline and teal colour (scroll-spy below). */
  header.header-bar { transition: box-shadow .25s ease; }
  header.header-bar[data-scrolled] { box-shadow: 0 10px 28px -18px rgb(23 18 58 / .35); }
  .nav-link[aria-current='location'] { color: var(--color-teal-deep); text-decoration-color: var(--color-teal-deep); }
  /* Phone menu: a compact right-hand drawer (like the base site's) that fits one screen without scrolling. */
  dialog.drawer { margin: 0 0 0 auto; height: 100dvh; max-height: none; width: min(22rem, 92vw); max-width: none; padding: 0; border: 0; background: #fff; color: var(--color-text); flex-direction: column; overflow-y: auto; box-shadow: -18px 0 50px -20px rgb(23 18 58 / .45); }
  dialog.drawer[open] { display: flex; }
  dialog.drawer::backdrop { background: rgb(23 18 58 / .45); }
  .drawer-grid { border-top: 1px solid var(--color-line); }
  .drawer-grid li { border-bottom: 1px solid var(--color-line); }
  .drawer-grid li:nth-child(odd) { padding-right: .75rem; border-right: 1px solid var(--color-line); }
  .drawer-grid li:nth-child(even) { padding-left: 1rem; }
  @media (min-width: 80rem) { dialog.drawer { display: none !important; } }
  @media (prefers-reduced-motion: no-preference) {
    dialog.drawer { transform: translateX(100%); transition: transform .32s var(--ease-soft), overlay .32s allow-discrete, display .32s allow-discrete; }
    dialog.drawer[open] { transform: none; }
    @starting-style { dialog.drawer[open] { transform: translateX(100%); } }
    dialog.drawer::backdrop { transition: opacity .32s, overlay .32s allow-discrete, display .32s allow-discrete; opacity: 0; }
    dialog.drawer[open]::backdrop { opacity: 1; }
    @starting-style { dialog.drawer[open]::backdrop { opacity: 0; } }
  }
</style>
<script>
  // Scroll-spy + scrolled shadow for the header bar. Light: one IntersectionObserver on the six sections, one passive
  // scroll listener that only toggles an attribute. Inner pages (no sections) just get the shadow.
  const bar = document.querySelector<HTMLElement>('header.header-bar')
  if (bar) {
    const sync = () => { bar.toggleAttribute('data-scrolled', scrollY > 8) }
    sync(); addEventListener('scroll', sync, { passive: true })
    const links = [...document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Main"] a.nav-link')]
    const byId = new Map(links.map(a => [a.getAttribute('href')?.split('#')[1] ?? '', a] as const))
    const targets = [...byId.keys()].map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[]
    if (targets.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        for (const e of entries) if (e.isIntersecting) { links.forEach(a => a.removeAttribute('aria-current')); byId.get(e.target.id)?.setAttribute('aria-current', 'location') }
      }, { rootMargin: '-45% 0px -50% 0px' })
      targets.forEach(t => io.observe(t))
    }
  }
</script>
<script>
  const btn = document.getElementById('menu-btn')
  const menu = document.getElementById('menu-dialog') as HTMLDialogElement | null
  if (btn && menu && typeof menu.showModal === 'function') {
    btn.setAttribute('role', 'button')
    btn.addEventListener('click', e => { e.preventDefault(); menu.showModal() })
    menu.addEventListener('close', () => btn.focus())
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu.close()))
    menu.addEventListener('click', e => { if (e.target === menu) menu.close() })
    matchMedia('(min-width: 80rem)').addEventListener('change', e => { if (e.matches && menu.open) menu.close() })
  }
</script>
