---
// Spec 4.0-4.2, navbar redesign 2026-11-02 (workspace/03-decisions/2026-11-02-navbar-redesign.md).
// Desktop (lg): a dark utility row (both numbers + open status, language help, not sticky), then a
// white 80 px sticky header with the sample's six anchors, a filled "Make an appointment" (opens the call dialog) and a
// ghost "Visit" from 2xl. Once the header sticks it compacts by transform only (80 -> 68 px visible), frosts and
// takes a soft shadow. One teal indicator slides under the link of the section you are reading (scroll-spy) and
// previews the link under the pointer or keyboard focus. Below xl (1280) the Menu button replaces the links.
// Phone: a white 64 px header, NOT sticky (the bottom sticky bar carries Make an appointment / Visit; owner answer 2),
// with a "Menu" button that opens a native <dialog> drawer (Escape, the backdrop, a link or Close closes it; focus
// returns to the button). No JS: "Menu" is a link to the footer's #site-nav. Every target >= 44 px.
// Phones and tablets: every animation plays once (global rule under 64rem), no Pause control anywhere (removed on desktop too, owner request 2026-11-02).
import Logo from './Logo.astro'
import OpenNow from './OpenNow.astro'
import FactSlot from './FactSlot.astro'
import Icon from './Icon.astro'
import { offices, practice, telHref, isShown } from '../data/practice'
export const nav = [
  { label: 'Doctors', href: '/#doctors' },
  { label: 'Services', href: '/#services' },
  { label: 'All ages', href: '/#care' },
  { label: 'Locations', href: '/#offices' },
  { label: 'Insurance', href: '/#insurance' },
  { label: 'FAQ', href: '/#faq' },
]
const place = (o: (typeof offices)[number]) => o.neighborhood.split(',')[0]
// Drawer entrance order: six links, the request row, the call label, the office rows, the footer line.
const stagger = { request: nav.length, label: nav.length + 1, office: nav.length + 2, foot: nav.length + 2 + offices.length }
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-indigo">Skip to content</a>

<nav aria-label="Call an office" class="utility on-dark hidden bg-indigo-soft px-8 text-[0.84rem] text-on-dark lg:block">
  <div class="mx-auto flex max-w-[1160px] items-center">
    <ul class="flex items-center">
      {offices.map(o => (
        <li class="utility-office flex items-center gap-2.5 whitespace-nowrap">
          <span>{place(o)}</span>
          <a href={telHref(o.phone)} class="utility-tel tabular inline-flex min-h-11 items-center font-semibold text-white">{o.phone}</a>
          <OpenNow office={o} class="text-[0.8rem]" />
        </li>
      ))}
    </ul>
    <div class="ml-auto flex items-center gap-5">
      <a href="#language-help" class="utility-link hidden min-h-11 items-center whitespace-nowrap xl:inline-flex">Language help</a>
      <span aria-hidden="true" class="utility-rule hidden xl:block"></span>
    </div>
  </div>
</nav>

<div class="header-sentinel" aria-hidden="true"></div>
<header class="header-bar border-b border-line bg-white px-5 md:px-8 lg:sticky lg:top-0 lg:z-40">
  <div class="header-inner mx-auto flex h-16 max-w-[1160px] items-center justify-between gap-3 lg:h-20">
    <Logo tagline class="shrink-0" />
    <nav aria-label="Main" class="main-nav relative hidden xl:block">
      <ul class="flex items-center gap-1">
        {nav.map(item => (<li><a href={item.href} data-spy class="nav-link inline-flex min-h-11 items-center whitespace-nowrap px-2.5 text-[0.95rem] font-semibold text-indigo">{item.label}</a></li>))}
      </ul>
      <span class="nav-ind" aria-hidden="true"></span>
    </nav>
    <div class="hidden items-center gap-2.5 max-xl:ml-auto lg:flex">
      <a href="/locations" data-call class="cta btn btn-primary inline-flex min-h-11 items-center gap-2 whitespace-nowrap rounded-full pl-4 pr-5 text-[0.95rem] font-bold"><Icon name="phone" size={17} />Make an appointment</a>
      <a href="/#offices" class="btn btn-ghost hidden min-h-11 2xl:inline-flex items-center whitespace-nowrap rounded-full px-5 text-[0.95rem] font-semibold">Visit</a>
    </div>
    <a href="#site-nav" id="menu-btn" aria-haspopup="dialog" aria-label="Menu" class="menu-pill btn inline-flex xl:hidden">
      <svg class="burger" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="b1" d="M4 7h16"/><path class="b2" d="M4 12h16"/><path class="b3" d="M4 17h16"/></svg><span class="max-[380px]:hidden">Menu</span>
    </a>
  </div>
</header>

<dialog id="menu-dialog" aria-label="Menu" class="drawer">
  <div class="drawer-top sticky top-0 z-10 flex h-16 shrink-0 items-center justify-between border-b border-line px-5 md:pr-8">
    <Logo />
    <form method="dialog"><button class="menu-pill drawer-close btn inline-flex" aria-label="Close menu" autofocus>
      <svg class="burger" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="b1" d="M4 7h16"/><path class="b2" d="M4 12h16"/><path class="b3" d="M4 17h16"/></svg></button></form>
  </div>
  <div class="drawer-body flex flex-1 flex-col pb-[calc(1rem+env(safe-area-inset-bottom))]">
    <nav aria-label="Site sections">
      <ul class="drawer-list">
        {nav.map((item, i) => (<li data-i={i}><a href={item.href} data-spy class="drawer-link">{item.label}</a></li>))}
      </ul>
    </nav>
    <h2 id="drawer-call-label" data-i={Math.min(stagger.label, 10)} class="mt-5 px-5 font-sans text-[0.75rem] font-bold uppercase tracking-[0.12em] text-muted">Call to book</h2>
    <ul class="drawer-calls mt-2 grid gap-2 px-5" aria-labelledby="drawer-call-label">
      {offices.map((o, i) => (
        <li data-i={Math.min(stagger.office + i, 10)}><a href={telHref(o.phone)} class={`drawer-call ${i === 0 ? 'is-primary' : ''}`}>
          <span class="drawer-call-place"><span class="sr-only">Call {practice.name}, </span>{place(o)}</span>
          <span class="drawer-call-num"><Icon name="phone" size={17} /><span class="tabular">{o.phone}</span></span>
          <OpenNow office={o} fallback="See hours" class="drawer-call-status" />
        </a></li>
      ))}
    </ul>
    <a href="/#request" data-i={Math.min(stagger.request, 10)} class="drawer-link drawer-request">Request a callback<Icon name="arrow" size={16} /></a>
    <div data-i={Math.min(stagger.foot, 10)} class="mt-auto px-5 pt-5 text-[0.85rem] leading-snug text-muted">
      {isShown(practice.languages) && <p>Language help: <FactSlot fact={practice.languages} /></p>}
      <p class="mt-1">In an emergency, call <strong class="font-semibold text-indigo">911</strong>.</p>
    </div>
  </div>
</dialog>
<style is:global>
  /* ---------- Utility row (desktop): quieter than the main bar; hairline rules between groups ---------- */
  .utility-office + .utility-office { position: relative; margin-inline-start: 1.5rem; padding-inline-start: 1.5rem; }
  @media (min-width: 80rem) { .utility-office + .utility-office { margin-inline-start: 2rem; padding-inline-start: 2rem; } }
  .utility-office + .utility-office::before, .utility-rule { content: ''; inline-size: 1px; block-size: 1rem; background: rgb(255 255 255 / .18); }
  .utility-office + .utility-office::before { position: absolute; inset-inline-start: 0; inset-block-start: 50%; translate: 0 -50%; }
  .utility-tel, .utility-link { text-decoration: underline 1px rgb(95 196 196 / .65); text-underline-offset: 5px; transition: text-decoration-color var(--m-state) var(--ease-state), color var(--m-state) var(--ease-state); }
  .utility-tel:hover, .utility-link:hover { text-decoration-color: var(--color-aqua); color: var(--color-aqua); }
  .utility-link:hover { color: #fff; }

  /* ---------- Main bar ---------- */
  header.header-bar { transition: transform .45s var(--ease-soft), box-shadow .45s var(--ease-soft), background-color .3s ease, border-color .3s ease; }
  .header-inner, .logo-mark { transition: transform .45s var(--ease-soft); }
  .logo-mark { transform-origin: 50% 100%; }
  /* Stuck (desktop only; the phone header is not sticky): compacts by transform, never by height, so nothing reflows. */
  @media (min-width: 64rem) {
    header.header-bar[data-scrolled] { transform: translateY(-.75rem); background-color: rgb(255 255 255 / .9); -webkit-backdrop-filter: blur(16px) saturate(1.6); backdrop-filter: blur(16px) saturate(1.6); border-color: rgb(227 221 240 / .7); box-shadow: 0 1px 0 rgb(23 18 58 / .03), 0 14px 30px -22px rgb(23 18 58 / .45); }
    header.header-bar[data-scrolled] .header-inner { transform: translateY(.375rem); }
    header.header-bar[data-scrolled] .logo-mark { transform: scale(.9); }
  }
  @media (prefers-reduced-transparency: reduce) { header.header-bar[data-scrolled] { background-color: #fff; -webkit-backdrop-filter: none; backdrop-filter: none; } }

  /* Links: colour shift on hover; the sliding indicator (JS) marks the current section. Without JS the global
     underline (global.css .nav-link) still marks hover, and aria-current keeps its teal colour. */
  .nav-link { transition: color var(--m-state) var(--ease-state), text-decoration-color var(--m-state) var(--ease-state); }
  .nav-link:hover, .nav-link[aria-current='location'] { color: var(--color-teal-deep); }
  .nav-link[aria-current='location'] { text-decoration-color: var(--color-teal-deep); }
  .main-nav[data-ind] .nav-link { text-decoration-color: transparent; }
  .nav-ind { position: absolute; inset-inline-start: 0; inset-block-end: .4rem; inline-size: 100px; block-size: 2px; border-radius: 2px; background: var(--color-teal-deep); pointer-events: none;
    transform-origin: 0 50%; transform: translateX(var(--x, 0)) scaleX(var(--s, 0)); opacity: 0;
    transition: transform .5s cubic-bezier(.22, 1, .36, 1), opacity .2s ease; }
  .nav-ind[data-on] { opacity: 1; }
  .nav-ind[data-instant] { transition: opacity .2s ease; }
  @media (forced-colors: active) { .nav-ind { display: none; } .main-nav[data-ind] .nav-link[aria-current] { text-decoration-color: LinkText; } }

  /* Make an appointment: a calmer shadow than the global teal glow, an inner highlight, the phone icon tilts on hover. */
  .cta.btn-primary { box-shadow: inset 0 1px 0 rgb(255 255 255 / .14), 0 1px 2px rgb(11 111 111 / .3), 0 8px 18px -12px rgb(11 111 111 / .7); }
  .cta.btn-primary:hover { box-shadow: inset 0 1px 0 rgb(255 255 255 / .14), 0 2px 4px rgb(11 111 111 / .25), 0 14px 26px -14px rgb(11 111 111 / .75); }
  .cta svg { transition: transform .4s var(--ease-bounce); }
  .cta:hover svg, .cta:focus-visible svg { transform: rotate(-14deg); }
  .cta:active { transform: scale(.97); }

  /* ---------- Menu / Close pill (shared by the header button and the drawer's close button) ---------- */
  .menu-pill { flex-shrink: 0; align-items: center; justify-content: center; gap: .5rem; block-size: 2.75rem; min-inline-size: 2.75rem; padding-inline: .85rem 1rem; border-radius: 999px; border: 1.5px solid var(--color-muted); background: #fff; color: var(--color-indigo); font-weight: 600; font-size: .95rem; }
  .menu-pill:hover { border-color: var(--color-teal-deep); background: var(--color-mist); }
  .menu-pill:active { transform: scale(.96); }
  @media (width < 23.75rem) { .menu-pill { inline-size: 2.75rem; padding-inline: 0; } }
  .drawer-close { inline-size: 2.75rem; padding-inline: 0; }
  .burger path { transform-box: fill-box; transform-origin: center; }
  /* Menu: the bottom line is shorter and grows on hover (a quiet cue that it is a control). */
  #menu-btn .b3 { transform-origin: left center; transform: scaleX(.6); transition: transform var(--m-state) var(--ease-state); }
  #menu-btn:is(:hover, :focus-visible) .b3 { transform: none; }
  /* Close: the same three lines meet in the middle, then turn into an X as the drawer arrives (resting state is the X: reduced motion shows it). */
  .drawer-close .b1 { transform: translateY(5px) rotate(45deg); }
  .drawer-close .b2 { opacity: 0; transform: scaleX(0); }
  .drawer-close .b3 { transform: translateY(-5px) rotate(-45deg); }

  /* ---------- Phone menu drawer: a right-hand panel that fits one screen without scrolling ---------- */
  dialog.drawer { margin: 0 0 0 auto; height: 100dvh; max-height: none; width: min(22rem, 92vw); max-width: none; padding: 0; border: 0; background: #fff; color: var(--color-text); flex-direction: column; overflow-y: auto; overscroll-behavior: contain; box-shadow: -24px 0 60px -28px rgb(23 18 58 / .5); }
  dialog.drawer[open] { display: flex; }
  @media (width < 22.5rem) { dialog.drawer { width: 100vw; } } /* small phones: full width so the logo and Close never touch */
  dialog.drawer::backdrop { background: rgb(23 18 58 / .42); }
  @media (min-width: 80rem) { dialog.drawer { display: none !important; } }
  @media (max-width: 79.99rem) { html:has(dialog.drawer[open]) { overflow: hidden; } }
  /* One column, one sans family, 56 px rows with hairlines (all 11 competitor menus that opened are single-column). */
  .drawer-list li { border-bottom: 1px solid var(--color-line); }
  .drawer-link { position: relative; display: flex; align-items: center; justify-content: space-between; gap: .5rem; min-block-size: clamp(3rem, 7dvh, 3.5rem); padding-inline: 1.25rem; font-family: var(--font-sans); font-size: 1.1rem; font-weight: 600; color: var(--color-indigo); transition: color var(--m-fast) ease, background-color var(--m-fast) ease; -webkit-tap-highlight-color: transparent; }
  .drawer-link:hover, .drawer-link:active { background: var(--color-mist); color: var(--color-teal-deep); }
  /* Section you are reading: teal words + a short rule (two cues, not colour alone). */
  .drawer-link[aria-current='location'] { color: var(--color-teal-deep); }
  .drawer-link[aria-current='location']::after { content: ''; inline-size: .9rem; block-size: 2px; border-radius: 2px; background: currentColor; }
  /* Call rows: Elmhurst filled (the one primary action), Hicksville outlined; both 12 px radius (--radius-field), status as TEXT. */
  .drawer-top { background: #fff; }
  dialog.drawer { scroll-padding-block: 4.5rem 1rem; }
  .drawer-call { display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: .75rem; row-gap: .1rem; min-block-size: 3.5rem; padding: .6rem 1rem; border-radius: var(--radius-field, 12px); border: 1.5px solid var(--color-teal-deep); background: var(--color-mist); color: var(--color-teal-deep); transition: background-color var(--m-fast) ease, transform var(--m-fast) ease; -webkit-tap-highlight-color: transparent; }
  .drawer-call.is-primary { background: var(--color-teal-deep); color: #fff; }
  .drawer-call:hover { background: #d3e8e6; }
  .drawer-call.is-primary:hover { background: #095c5c; }
  .drawer-call:active { transform: scale(.985); }
  .drawer-call-place { font-weight: 700; line-height: 1.2; }
  .drawer-call-num { display: inline-flex; align-items: center; gap: .4rem; font-weight: 700; white-space: nowrap; }
  .drawer-call .drawer-call-status, .drawer-call .drawer-call-status[data-state] { grid-column: 1 / -1; font-size: .85rem; line-height: 1.3; color: inherit; }
  .drawer-call-status[data-state='closed']::before { box-shadow: none; border: 1.5px solid currentColor; } /* survives forced colours */
  @media (width < 22.5rem) { .drawer-call { grid-template-columns: 1fr; } .drawer-call-num { grid-row: 2; } }
  @media (height < 40rem) { .drawer-link { min-block-size: 3.25rem; } }
  .drawer-request { margin-top: .5rem; border-block: 1px solid var(--color-line); }
  .drawer-request:hover { background: var(--color-mist); }
  :is(.drawer-link, .drawer-request, .drawer-call):focus-visible { outline-offset: -3px; }
  .drawer-call:focus-visible { outline-color: var(--color-indigo); outline-offset: 3px; }

  /* Motion: the drawer slides in on a soft sheet curve and leaves faster; rows arrive in reading order, once per
     open (transform + opacity only). Everything here is off under reduced motion (global rule), and nothing loops. */
  @media (prefers-reduced-motion: no-preference) {
    dialog.drawer { transform: translateX(100%); transition: transform .22s cubic-bezier(.4, 0, 1, 1), overlay .22s allow-discrete, display .22s allow-discrete; }
    dialog.drawer[open] { transform: none; transition-duration: .42s; transition-timing-function: var(--ease-sheet); }
    @starting-style { dialog.drawer[open] { transform: translateX(100%); } }
    dialog.drawer::backdrop { opacity: 0; transition: opacity .22s ease-in, overlay .22s allow-discrete, display .22s allow-discrete; }
    dialog.drawer[open]::backdrop { opacity: 1; transition-duration: .42s; transition-timing-function: ease-out; }
    @starting-style { dialog.drawer[open]::backdrop { opacity: 0; } }
    dialog.drawer[open] [data-i] { animation: drawer-row .42s cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(90ms + var(--i) * 25ms); }
    dialog.drawer[open] .drawer-close :is(.b1, .b2, .b3) { animation: .38s cubic-bezier(.65, 0, .35, 1) .12s backwards; }
    dialog.drawer[open] .drawer-close .b1 { animation-name: burger-b1; }
    dialog.drawer[open] .drawer-close .b2 { animation-name: burger-b2; }
    dialog.drawer[open] .drawer-close .b3 { animation-name: burger-b3; }
  }
  .drawer [data-i] { --i: 0; } .drawer [data-i='1'] { --i: 1; } .drawer [data-i='2'] { --i: 2; } .drawer [data-i='3'] { --i: 3; } .drawer [data-i='4'] { --i: 4; } .drawer [data-i='5'] { --i: 5; }
  .drawer [data-i='6'] { --i: 6; } .drawer [data-i='7'] { --i: 7; } .drawer [data-i='8'] { --i: 8; } .drawer [data-i='9'] { --i: 9; } .drawer [data-i='10'] { --i: 10; }
  @keyframes drawer-row { from { opacity: 0; transform: translateX(14px); } }
  @keyframes burger-b1 { from { transform: none; } 50% { transform: translateY(5px); } }
  @keyframes burger-b2 { from { opacity: 1; transform: none; } 45% { opacity: 0; } }
  @keyframes burger-b3 { from { transform: none; } 50% { transform: translateY(-5px); } }
</style>
<script>
  // Sticky state, scroll-spy and the sliding indicator. Light: one rAF-throttled passive scroll listener that only
  // toggles an attribute, one IntersectionObserver on the six sections. Inner pages (no sections) get the sticky state only.
  const bar = document.querySelector<HTMLElement>('header.header-bar')
  const sentinel = document.querySelector<HTMLElement>('.header-sentinel')
  const STICK_SLACK = 4 // px past the sticking point before the header compacts
  if (bar && sentinel) {
    let queued = false
    const sync = () => { queued = false; bar.toggleAttribute('data-scrolled', sentinel.getBoundingClientRect().top < -STICK_SLACK) }
    sync()
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(sync) } }, { passive: true })
  }

  const mainNav = document.querySelector<HTMLElement>('nav.main-nav')
  const ind = mainNav?.querySelector<HTMLElement>('.nav-ind') ?? null
  let pointed: HTMLAnchorElement | null = null
  const placeIndicator = () => {
    if (!mainNav || !ind) return
    const target = pointed ?? mainNav.querySelector<HTMLAnchorElement>('a[aria-current]')
    if (!target || mainNav.offsetParent === null) { ind.removeAttribute('data-on'); return }
    const wasOff = !ind.hasAttribute('data-on')
    const navBox = mainNav.getBoundingClientRect(), box = target.getBoundingClientRect()
    const pad = parseFloat(getComputedStyle(target).paddingLeft) || 0
    if (wasOff) ind.setAttribute('data-instant', '')
    ind.style.setProperty('--x', `${box.left - navBox.left + pad}px`)
    ind.style.setProperty('--s', String((box.width - pad * 2) / 100))
    if (wasOff) { void ind.offsetWidth; ind.removeAttribute('data-instant') }
    ind.setAttribute('data-on', '')
  }
  if (mainNav && ind) {
    mainNav.setAttribute('data-ind', '')
    mainNav.querySelectorAll<HTMLAnchorElement>('a.nav-link').forEach(a => {
      a.addEventListener('pointerenter', () => { pointed = a; placeIndicator() })
      a.addEventListener('focus', () => { pointed = a; placeIndicator() })
    })
    mainNav.addEventListener('pointerleave', () => { pointed = null; placeIndicator() })
    mainNav.addEventListener('focusout', e => { if (!mainNav.contains(e.relatedTarget as Node | null)) { pointed = null; placeIndicator() } })
    addEventListener('resize', placeIndicator, { passive: true })
    document.fonts?.ready.then(placeIndicator)
  }

  // Scroll-spy: marks the matching link in the desktop nav AND in the phone drawer.
  const spyLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[data-spy]')]
  const idOf = (a: HTMLAnchorElement) => a.getAttribute('href')?.split('#')[1] ?? ''
  const targets = [...new Set(spyLinks.map(idOf))].map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[]
  if (targets.length && 'IntersectionObserver' in window) {
    // Track which section crosses the reading line; clear the highlight when none does (top of the page, or over a
    // section that is not in the nav), so a stale link never stays lit.
    const crossing = new Set<string>()
    const io = new IntersectionObserver(entries => {
      for (const e of entries) e.isIntersecting ? crossing.add(e.target.id) : crossing.delete(e.target.id)
      const currentId = [...crossing].at(-1) ?? ''
      spyLinks.forEach(a => currentId && idOf(a) === currentId ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current'))
      placeIndicator()
    }, { rootMargin: '-45% 0px -50% 0px' })
    targets.forEach(t => io.observe(t))
  }
</script>
<script>
  const btn = document.getElementById('menu-btn')
  const menu = document.getElementById('menu-dialog') as HTMLDialogElement | null
  if (btn && menu && typeof menu.showModal === 'function') {
    btn.setAttribute('role', 'button')
    btn.addEventListener('click', e => { e.preventDefault(); menu.showModal() })
    btn.addEventListener('keydown', e => { if (e.key === ' ') { e.preventDefault(); menu.showModal() } }) // role=button: Space must work (SC 2.1.1)
    let followedLink = false
    menu.addEventListener('close', () => { if (!followedLink && btn.offsetParent) btn.focus({ preventScroll: true }); followedLink = false })
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { followedLink = true; menu.close() }))
    menu.addEventListener('click', e => { if (e.target === menu) menu.close() })
    matchMedia('(min-width: 80rem)').addEventListener('change', e => { if (e.matches && menu.open) menu.close() })
  }
</script>
