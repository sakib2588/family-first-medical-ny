---
// Inner-page header, Home style: a calm light band (eyebrow + serif H1 + one-line lead). Flat straight edges.
// Breadcrumb is a real <nav>. The eyebrow defaults to the first crumb ("Doctors", "Locations"...).
interface Props { title: string; lead?: string; eyebrow?: string; crumbs?: readonly (readonly [label: string, href: string])[] }
const { title, lead, eyebrow, crumbs = [] } = Astro.props
const kicker = eyebrow ?? crumbs[0]?.[0]
---
<section data-tone="cream" class="ph px-5 pb-8 pt-4 md:px-8 md:pb-12 md:pt-8">
  <div class="mx-auto max-w-[1160px]">
    {crumbs.length > 0 && (<nav aria-label="Breadcrumb" class="mb-3 text-sm text-muted"><ol class="flex flex-wrap gap-x-2">
      <li><a class="inline-flex min-h-11 items-center underline underline-offset-4" href="/">Home</a></li>
      {crumbs.map(([label, href], i) => (<li class="flex items-center gap-2"><span aria-hidden="true">/</span><a class="inline-flex min-h-11 items-center underline underline-offset-4" href={href} aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{label}</a></li>))}
    </ol></nav>)}
    {kicker && <p class="eyebrow">{kicker}</p>}
    <h1 class="mt-2 max-w-[22ch] text-[2.1rem] leading-[1.1] md:max-w-[28ch] md:text-[3.1rem]">{title}</h1>
    {lead && <p class="mt-4 max-w-[46ch] text-[1.06rem] md:text-[1.18rem]">{lead}</p>}
  </div>
</section>
<style is:global>
  /* The header ground is the cream tone with a mist wash from the top right; the arch outline is a faint static echo of the shape device. */
  .ph { overflow: hidden; }
  .ph::before { content: ''; position: absolute; z-index: 0; inset-block-end: -5rem; inset-inline-end: 1rem; inline-size: 15rem; block-size: 15rem; border: 2px solid rgb(11 111 111 / .10); border-radius: 999px 999px 0 0; pointer-events: none; }
  @media (min-width: 64rem) { .ph::before { inline-size: 24rem; block-size: 24rem; inset-inline-end: 6rem; inset-block-end: -8rem; } }
</style>
