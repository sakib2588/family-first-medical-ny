---
// Shared section frame: tone sets the ground; the inner container sets the max width.
interface Props { id?: string; tone?: 'cream' | 'white' | 'lavender' | 'indigo'; class?: string; label?: string }
const { id, tone = 'cream', class: cls = '', label } = Astro.props
const tones = { cream: 'bg-cream', white: 'bg-white', lavender: 'bg-lavender', indigo: 'on-dark bg-indigo text-on-dark' }
---
<section id={id} aria-label={label} class={`px-5 py-16 md:px-8 lg:py-24 ${tones[tone]} ${cls}`}>
  <div class="mx-auto max-w-[1160px]"><slot /></div>
</section>
