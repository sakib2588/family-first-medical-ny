---
// The one repeated pair: Call (ghost) + Request (filled primary). Used on doctor and office pages.
import Icon from './Icon.astro'
---
<div class="flex flex-wrap gap-3">
  <a href="/contact" class="btn btn-primary inline-flex min-h-12 items-center justify-center rounded-full px-6 font-semibold">Request a visit</a>
  <a href="/locations" data-call class="btn btn-ghost inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 font-semibold"><Icon name="phone" size={18} />Call</a>
</div>
