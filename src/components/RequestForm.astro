---
// Contact-only callback request (CLAUDE.md red line; hipaa-compliance -> healthcare-phi-compliance -> security-review
// applied 2026-10-31): exactly name, phone, office, best time. NO symptoms, DOB, insurance or free text. It sends
// nothing: no action, no fetch, no storage, no logging (needs an endpoint, a BAA and counsel first).
// Selected office/time chips are white with a 2 px teal-deep border and a check mark, so "Send request" stays the
// only filled button. Errors: state-error words + icon, tied to the field with aria-describedby.
import { offices } from '../data/practice'
const fieldClass = 'mt-1.5 block min-h-[3.06rem] w-full rounded-[0.75rem] border-[1.5px] border-muted bg-white px-4 text-base text-indigo aria-[invalid=true]:border-state-error'
const times = ['Morning', 'Afternoon', 'Either']
const chip = 'group flex min-h-12 cursor-pointer items-center justify-center gap-1.5 rounded-[0.75rem] border-[1.5px] border-muted bg-white px-3 font-medium text-indigo has-[:checked]:border-2 has-[:checked]:border-teal-deep has-[:checked]:font-semibold has-[:focus-visible]:outline has-[:focus-visible]:outline-[3px] has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-indigo'
const check = '<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
const errIcon = '<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 8v5M12 16h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z"/></svg>'
---
<form id="request-form" class="space-y-4" novalidate>
  <div>
    <label for="name" class="font-semibold text-indigo">Your name</label>
    <input id="name" name="name" autocomplete="name" required maxlength="80" aria-describedby="name-error" class={fieldClass} />
    <p id="name-error" class="mt-1 hidden items-center gap-1.5 text-[0.88rem] font-medium text-state-error" data-error><Fragment set:html={errIcon} />Please enter your name.</p>
  </div>
  <div>
    <label for="phone" class="font-semibold text-indigo">Phone number</label>
    <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="20" pattern="[0-9\s\(\)+.\-]{7,20}" aria-describedby="phone-error" class={fieldClass} />
    <p id="phone-error" class="mt-1 hidden items-center gap-1.5 text-[0.88rem] font-medium text-state-error" data-error><Fragment set:html={errIcon} />Please enter a phone number we can call.</p>
  </div>
  <fieldset>
    <legend class="font-semibold text-indigo">Which office?</legend>
    <div class="mt-2 grid grid-cols-2 gap-3">
      {offices.map((o, i) => (<label class={chip}><input class="sr-only" type="radio" name="office" value={o.slug} checked={i === 0} /><span class="hidden text-teal-deep group-has-[:checked]:inline"><Fragment set:html={check} /></span>{o.neighborhood.split(',')[0]}</label>))}
    </div>
  </fieldset>
  <fieldset>
    <legend class="font-semibold text-indigo">Best time to call</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-3">
      {times.map((t, i) => (<label class={chip}><input class="sr-only" type="radio" name="time" value={t.toLowerCase()} checked={i === 2} /><span class="hidden text-teal-deep group-has-[:checked]:inline"><Fragment set:html={check} /></span>{t}</label>))}
    </div>
  </fieldset>
  <p class="text-[0.88rem] text-text">Please do not include symptoms or health details. In an emergency, call 911. We use your name and number only to call you back about a visit. <a href="/legal/privacy" class="underline underline-offset-4">Privacy policy</a>.</p>
  <button type="submit" class="btn btn-primary inline-flex min-h-[3.06rem] w-full items-center justify-center rounded-full bg-teal-deep text-[1.06rem] font-semibold text-white hover:bg-teal-darker">Send request</button>
  <p id="request-status" role="status" class="min-h-6 text-[0.88rem] font-medium text-teal-deep"></p>
</form>
<script>
  const form = document.getElementById('request-form') as HTMLFormElement | null
  const status = document.getElementById('request-status')
  form?.addEventListener('submit', e => {
    e.preventDefault()
    let first: HTMLInputElement | null = null
    for (const input of form.querySelectorAll<HTMLInputElement>('#name, #phone')) {
      const bad = !input.checkValidity() || input.value.trim() === ''
      input.setAttribute('aria-invalid', String(bad))
      const err = document.getElementById(`${input.id}-error`)
      err?.classList.toggle('hidden', !bad); err?.classList.toggle('flex', bad)
      if (bad && !first) first = input
    }
    if (first) { first.focus(); if (status) status.textContent = ''; return }
    if (status) { status.textContent = 'Not sent. Online requests are not connected yet. Please call your office to book.'; status.classList.replace('text-teal-deep', 'text-state-error') }
  })
</script>
