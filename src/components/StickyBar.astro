---
// Task 1: sticky Call + Request bar (phone only). Hidden until the hero has scrolled away,
// and hidden again over the request form and footer. Without JS it never shows (no layout trap).
const request = Astro.url.pathname === '/' ? '#request' : '/contact'
---
<div id="sticky-bar" inert data-visible="false" class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-line bg-white/95 px-4 pt-3 backdrop-blur-sm transition-transform duration-200 data-[visible=true]:translate-y-0 md:hidden pb-[max(0.75rem,env(safe-area-inset-bottom))]">
  <div class="mx-auto flex max-w-md gap-3">
    <a href="/locations" data-call class="inline-flex min-h-12 flex-1 items-center justify-center rounded-full border-2 border-teal-deep font-semibold text-teal-deep">Call</a>
    <a href={request} class="inline-flex min-h-12 flex-[1.4] items-center justify-center rounded-full bg-teal-deep font-semibold text-white">Request a visit</a>
  </div>
</div>
<script>
  const bar = document.getElementById('sticky-bar')
  const hero = document.getElementById('hero')
  const hide = ['request', 'site-footer'].map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[]
  if (bar && !hero) { bar.dataset.visible = 'true'; bar.removeAttribute('inert') }
  if (bar && hero && 'IntersectionObserver' in window) {
    let heroVisible = true
    const covered = new Set<Element>()
    const update = () => {
      const show = !heroVisible && covered.size === 0
      bar.dataset.visible = String(show)
      show ? bar.removeAttribute('inert') : bar.setAttribute('inert', '')
    }
    new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; update() }, { threshold: 0.05 }).observe(hero)
    hide.forEach(el => new IntersectionObserver(([e]) => { e.isIntersecting ? covered.add(el) : covered.delete(el); update() }).observe(el))
  }
</script>
