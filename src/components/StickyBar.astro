---
// Sticky bar (spec 4.15, phone only, relabelled 2026-11-02 to match the sample): "Make an appointment" filled
// (opens the call dialog), "Visit" outlined (offices).
// Appears only after the hero has scrolled away (one filled action in the fold) and hides over the request band and
// the footer on every page (inner pages: visible until the footer or request band reaches the screen). Motion #5: slides up (m-sheet); instant with reduced motion. Without JS it never shows.
const visit = Astro.url.pathname === '/' ? '#offices' : '/locations'
---
<aside id="sticky-bar" aria-label="Make an appointment or visit" inert data-visible="false" class="fixed inset-x-0 bottom-0 z-30 translate-y-full frost bg-white px-5 pt-3 shadow-lift transition-transform duration-300 ease-(--ease-sheet) data-[visible=true]:translate-y-0 lg:hidden pb-[max(0.75rem,env(safe-area-inset-bottom))]">
  <div class="mx-auto flex max-w-md gap-3">
    <a href="/locations" data-call class="btn btn-primary inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full font-bold">Make an appointment</a>
    <a href={visit} class="btn btn-ghost inline-flex min-h-12 flex-[0_0_6.5rem] items-center justify-center rounded-full font-semibold">Visit</a>
  </div>
</aside>
<script>
  const bar = document.getElementById('sticky-bar')
  const hero = document.getElementById('hero')
  const hide = ['request', 'site-footer'].map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[]
  if (bar) {
    const show = (on: boolean) => { bar.dataset.visible = String(on); on ? bar.removeAttribute('inert') : bar.setAttribute('inert', '') }
    if (!hero) show(true) // inner pages: visible from the start (and if IntersectionObserver is missing)
    if ('IntersectionObserver' in window) {
      // Hidden while the hero is in view (Home only) and over the request band and the footer, on every page.
      let heroVisible = !!hero
      const covered = new Set<Element>()
      const update = () => show(!heroVisible && covered.size === 0)
      if (hero) new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; update() }, { threshold: 0.05 }).observe(hero)
      hide.forEach(el => new IntersectionObserver(([e]) => { e.isIntersecting ? covered.add(el) : covered.delete(el); update() }).observe(el))
    }
  }
</script>
