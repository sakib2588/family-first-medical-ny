---
import Section from '../Section.astro'
import Icon from '../Icon.astro'
const offices = [
  { name: 'Elmhurst office', addr: '123 Sample Street, Elmhurst, NY 11373', phone: '(718) 555-0142', today: 'Open today, 9 AM to 6 PM' },
  { name: 'Hicksville office', addr: '456 Example Avenue, Hicksville, NY 11801', phone: '(516) 555-0188', today: 'Open today, 10 AM to 5 PM' },
]
---
<Section id="locations" tone="lavender">
  <span class="mb-4 block h-1 w-10 rounded-full bg-gold" aria-hidden="true"></span>
  <h2 class="text-[1.9rem] md:text-4xl">Two offices, one team</h2>
  <ul class="mt-8 space-y-4 md:mt-12 md:grid md:grid-cols-2 md:gap-6 md:space-y-0">
    {offices.map(o => (
      <li class="rounded-3xl bg-white p-5 md:p-8">
        <h3 class="text-xl md:text-2xl">{o.name}</h3>
        <p class="mt-3 flex items-start gap-2 text-[0.97rem] md:text-base"><Icon name="pin" size={18} class="mt-1 shrink-0 text-teal-deep" />{o.addr}</p>
        <p class="tabular mt-2 flex items-start gap-2 text-[0.97rem] md:text-base"><Icon name="clock" size={18} class="mt-1 shrink-0 text-teal-deep" />{o.today}</p>
        <div class="mt-5 grid grid-cols-2 gap-3 md:max-w-sm">
          <a href={`tel:+1${o.phone.replace(/\D/g, '')}`} class="btn inline-flex min-h-12 items-center justify-center gap-2 rounded-full border-2 border-teal-deep font-semibold text-teal-deep hover:bg-teal-deep hover:text-white">Call</a>
          <a href="#locations" class="btn inline-flex min-h-12 items-center justify-center rounded-full border-2 border-line font-semibold text-indigo hover:border-indigo">Directions</a>
        </div>
      </li>
    ))}
  </ul>
</Section>
