---
// Offices, photo-led like the reference site but our own: entrance photo (named slot until real), the number as
// visible text, the full week from practice.ts with today's row marked, getting-here facts and the doctors there.
// White cards on the one dark band. Call is outlined: a repeated per-item action never outranks the page's
// one filled action (U08.2). Every fact comes from practice.ts (CLAUDE.md).
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import OpenNow from '../OpenNow.astro'
import FactSlot from '../FactSlot.astro'
import PhotoSlot from '../PhotoSlot.astro'
import { offices, doctorBySlug, telHref, mapsHref, fullWeek, isShown } from '../../data/practice'
---
<Section id="locations" tone="indigo">
  <h2 class="text-[1.9rem] md:text-4xl">Our two offices</h2>
  <ul class="mt-8 space-y-6 md:mt-12 md:grid md:grid-cols-2 md:gap-6 md:space-y-0">
    {offices.map(o => (
      <li class="overflow-hidden rounded-3xl bg-white text-text">
        <div class="relative px-3 pt-3">
          <PhotoSlot fact={o.photo} class="aspect-[16/10] w-full" />
          <span class="absolute -bottom-4 left-6 rounded-full border border-line bg-white px-4 py-1.5 text-sm font-semibold text-indigo">{o.neighborhood}</span>
        </div>
        <div class="p-5 pt-8 md:p-8 md:pt-9">
          <h3 class="text-xl text-indigo md:text-2xl"><a href={`/locations/${o.slug}`} class="underline-offset-4 hover:underline">{o.name}</a></h3>
          <p class="mt-3 flex items-start gap-2 text-[0.97rem] md:text-base"><Icon name="pin" size={18} class="mt-1 shrink-0 text-muted" />{o.addr}</p>
          <p class="mt-1.5 flex items-start gap-2 text-[0.97rem] md:text-base"><Icon name="phone" size={18} class="mt-1 shrink-0 text-muted" /><a href={telHref(o.phone)} class="tabular inline-flex min-h-11 items-center font-semibold text-teal-deep underline underline-offset-4 -my-2.5">{o.phone}</a></p>
          <p class="tabular mt-1.5 flex items-start gap-2 text-[0.97rem] font-medium text-indigo md:text-base"><Icon name="clock" size={18} class="mt-1 shrink-0 text-muted" /><OpenNow office={o} fallback="See the hours below" /></p>

          <h4 class="mt-6 text-sm font-semibold text-indigo">Hours</h4>
          <dl class="tabular mt-2 divide-y divide-line border-y border-line text-[0.93rem]" data-week>
            {fullWeek(o).map(w => (
              <div data-weekday={w.day} class="flex justify-between gap-4 px-2 py-1.5"><dt class="text-muted">{w.name}</dt><dd class="shrink-0 whitespace-nowrap text-right font-semibold text-indigo">{w.hours}</dd></div>
            ))}
          </dl>

          {o.access.some(a => isShown(a.fact)) && (<>
            <h4 class="mt-6 text-sm font-semibold text-indigo">Getting here</h4>
            <ul class="mt-2 space-y-1 text-[0.95rem] text-indigo">
              {o.access.filter(a => isShown(a.fact)).map(a => (<li><span class="text-muted">{a.label}:</span> <FactSlot fact={a.fact} /></li>))}
            </ul>
          </>)}

          <h4 class="mt-6 text-sm font-semibold text-indigo">Doctors here</h4>
          <p class="mt-1 text-[0.95rem]">
            {o.doctors.map(doctorBySlug).filter(Boolean).map((d, i, all) => (<>{i > 0 && (i === all.length - 1 ? ' and ' : ', ')}<a href={`/doctors/${d!.slug}`} class="inline-flex min-h-11 items-center font-medium text-indigo underline underline-offset-4 -my-2.5">{d!.name}</a></>))}
          </p>

          <div class="mt-6 grid grid-cols-2 gap-3 md:max-w-sm">
            <a href={telHref(o.phone)} aria-label={`Call the ${o.name}`} class="btn inline-flex min-h-12 items-center justify-center gap-2 rounded-full border-2 border-teal-deep font-semibold text-teal-deep hover:bg-teal-deep hover:text-white"><Icon name="phone" size={18} />Call</a>
            <a href={mapsHref(o.addr)} target="_blank" rel="noopener" aria-label={`Directions to the ${o.name} (opens Google Maps)`} class="btn inline-flex min-h-12 items-center justify-center gap-2 rounded-full border-2 border-line font-semibold text-indigo hover:border-indigo">Directions<Icon name="arrow" size={18} /></a>
          </div>
        </div>
      </li>
    ))}
  </ul>
</Section>
<script>
  // Mark today's row in each week, in New York time (both offices are there). Without JS no row is marked.
  const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short' }).format(new Date()))
  document.querySelectorAll<HTMLElement>(`[data-week] [data-weekday="${day}"]`).forEach(row => {
    row.classList.add('rounded-lg', 'bg-cream', 'font-bold')
    row.setAttribute('aria-current', 'date')
  })
</script>
