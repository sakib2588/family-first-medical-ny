---
// Offices (spec 4.7): cream ground, two white cards of equal height. Arch photo slot, caption-style neighbourhood
// (no text on the photo), status pill, address + Directions, the number as text, GROUPED hours with today's group
// marked (mist row + the word "Today", JS only), dated access slots, the doctors there, an outlined Call and a
// link to the full week. Every fact comes from practice.ts.
// Round 12 (owner: squashed arch photo, messy info): full-width photo with the live status on it, name + address,
// then two labelled columns (Hours | Getting there) on desktop, one action row (Call, Directions, Details).
// Desktop: address and hours side by side only from 80rem (xl); between 64 and 80rem the hours sit below the address
// (side by side they overflowed the card at 1024 px). Day labels never wrap; the full-week link is one underlined run.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import OpenNow from '../OpenNow.astro'
import FactSlot from '../FactSlot.astro'
import PhotoSlot from '../PhotoSlot.astro'
import { offices, telHref, mapsHref, fullWeek, weekSummary, isShown, type Office } from '../../data/practice'
// Same grouping as weekSummary, but keeps the day numbers so the script can mark today's group.
const groups = (o: Office) => fullWeek(o).reduce<{ from: string; to: string; hours: string; days: number[] }[]>((acc, d) => {
  const last = acc.at(-1)
  if (last && last.hours === d.hours) return [...acc.slice(0, -1), { ...last, to: d.name, days: [...last.days, d.day] }]
  return [...acc, { from: d.name, to: d.name, hours: d.hours, days: [d.day] }]
}, [])
const short = (n: string) => n.slice(0, 3)
// Phone (base-site pattern): the week as short segments, e.g. "Mon to Fri 9 AM to 6 PM", "Sat 9 AM to 4 PM", "Sun Closed".
// Each segment is rendered unbreakable so a line never splits inside one.
const segments = (o: Office) => weekSummary(o).map(([days, hours]) => `${days.split(' to ').map(short).join(' to ')} ${hours}`)
---
<Section id="offices">
  <p class="eyebrow">Locations</p>
      <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">Our two offices</h2>
  <ul class="mt-6 grid gap-4 lg:mt-8 lg:grid-cols-2 lg:gap-6">
    {offices.map(o => {
      const place = o.neighborhood.split(',')[0]
      return (
      <li class="office lift card-soft flex flex-col overflow-hidden">
        <div class="relative">
          <PhotoSlot fact={o.photo} class="office__photo aspect-[16/8] w-full !rounded-none lg:aspect-[16/7]" width={1056} height={520} />
          <p class="absolute bottom-3 left-3 rounded-full bg-white px-3 py-1.5 text-[0.82rem] font-semibold text-text shadow-[0_6px_16px_-8px_rgb(23_18_58/0.5)]"><OpenNow office={o} fallback="Hours below" /></p>
        </div>
        <div class="flex flex-1 flex-col p-5 lg:p-7">
          <h3 class="text-[1.35rem] leading-tight lg:text-[1.6rem]"><a href={`/locations/${o.slug}`} class="underline-offset-4 hover:underline">{o.name}</a></h3>
          <address class="mt-1 not-italic text-muted">{o.addr}</address>
          <div class="office__info mt-5 grid gap-3 xl:grid-cols-2 xl:gap-3">
            <div class="office__panel office__panel--hours">
              <h4 class="office__label"><Icon name="clock" size={16} />Hours</h4>
              <p class="tabular mt-2 text-[0.94rem] lg:hidden">{segments(o).map((seg, i) => (<>{i > 0 && ' · '}<span class="whitespace-nowrap">{seg}</span></>))}</p>
              <dl aria-label="Hours" class="tabular mt-2 hidden divide-y divide-line text-[0.94rem] lg:block" data-week>
                {groups(o).map(g => (
                  <div data-days={g.days.join(',')} class="flex min-h-10 items-center justify-between gap-3 rounded-lg px-2">
                    <dt class="whitespace-nowrap">{g.from === g.to ? short(g.from) : `${short(g.from)} to ${short(g.to)}`}<span data-today-label class="sr-only hidden">, today</span></dt>
                    <dd class="whitespace-nowrap font-semibold text-indigo">{g.hours}</dd>
                  </div>
                ))}
              </dl>
            </div>
            {o.access.some(a => isShown(a.fact)) && (
              <div class="office__panel office__panel--go">
                <h4 class="office__label office__label--go"><Icon name="pin" size={16} />Getting there</h4>
                <ul class="mt-2 grid gap-2 text-[0.94rem]">
                  {o.access.filter(a => isShown(a.fact)).map(a => (<li class="flex items-start gap-2 xl:whitespace-nowrap"><span class="office__dot mt-[.55rem] size-1.5 shrink-0 rounded-full" aria-hidden="true"></span><FactSlot fact={a.fact} /></li>))}
                </ul>
              </div>
            )}
          </div>
          <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-1 pt-6">
            <a href={telHref(o.phone)} class="btn btn-ghost inline-flex min-h-12 flex-1 basis-full items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 font-semibold sm:basis-auto"><Icon name="phone" size={18} />Call<span class="tabular">{o.phone}</span></a>
            <a href={mapsHref(o.addr)} target="_blank" rel="noopener" aria-label={`Directions to the ${o.name} (opens Google Maps)`} class="arrow-link inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">Directions<Icon name="arrow" size={18} /></a>
            <a href={`/locations/${o.slug}`} class="arrow-link inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">Details<Icon name="arrow" size={18} /></a>
          </div>
        </div>
      </li>
    )})}
  </ul>
</Section>
<script>
  // Mark today's group in New York time (both offices are there). Without JS no row is marked.
  const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short' }).format(new Date()))
  document.querySelectorAll<HTMLElement>('[data-week] [data-days]').forEach(row => {
    if (!row.dataset.days?.split(',').includes(String(day))) return
    row.classList.add('bg-mist', 'font-semibold', 'text-indigo')
    row.setAttribute('aria-current', 'date')
    row.querySelector('[data-today-label]')?.classList.remove('hidden')
  })
</script>
<style>
  /* Colour grading (design-system audit, round 13): Hours = teal role (today's row solid teal, white text 5.97:1),
     Getting there = warm gold role (label #7a520c on #fdf7ea 6.6:1; dots decorative). Same roles as the Visits cards. */
  .office__panel { padding: 1rem 1.1rem; border-radius: 1.1rem; }
  @media (min-width: 80rem) { .office__panel { padding: .9rem .95rem; } }
  .office__panel--hours { background: linear-gradient(160deg, #eef7f6, #e3f1ef); border: 1px solid #cfe5e2; }
  .office__panel--go { background: linear-gradient(160deg, #fdf8ee, #fbf0d9); border: 1px solid #f1e2bf; }
  .office__label--go { color: #7a520c !important; }
  .office__dot { background: #c98d1c; }
  .office__panel--hours :global([data-week] > div) { border-color: rgb(11 111 111 / .14); }
  .office__panel--hours :global([data-week] > div[aria-current='date']) { background: var(--color-teal-deep) !important; color: #fff !important; }
  .office__panel--hours :global([data-week] > div[aria-current='date'] :is(dt, dd, span)) { color: #fff !important; }
  /* Today: a small aqua dot before the day instead of the word (the word stays for screen readers). */
  .office__panel--hours :global([data-week] > div[aria-current='date'] dt::before) { content: ''; display: inline-block; inline-size: .45rem; block-size: .45rem; margin-inline-end: .45rem; border-radius: 999px; background: var(--color-aqua); vertical-align: .12em; }
  .office__label { display: flex; align-items: center; gap: .4rem; font-family: var(--font-sans); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-teal-deep); }
  @media (min-width: 64rem) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .office :global(.office__photo img) { transition: transform .7s var(--ease-soft); }
    .office:hover :global(.office__photo img) { transform: scale(1.04); }
  }
</style>
