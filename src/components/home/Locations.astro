---
// Offices (spec 4.7): cream ground, two white cards of equal height. Arch photo slot, caption-style neighbourhood
// (no text on the photo), status pill, address + Directions, the number as text, GROUPED hours with today's group
// marked (mist row + the word "Today", JS only), dated access slots, the doctors there, an outlined Call and a
// link to the full week. Every fact comes from practice.ts.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import OpenNow from '../OpenNow.astro'
import FactSlot from '../FactSlot.astro'
import PhotoSlot from '../PhotoSlot.astro'
import { offices, doctorBySlug, telHref, mapsHref, fullWeek, weekSummary, isShown, type Office } from '../../data/practice'
// Same grouping as weekSummary, but keeps the day numbers so the script can mark today's group.
const groups = (o: Office) => fullWeek(o).reduce<{ from: string; to: string; hours: string; days: number[] }[]>((acc, d) => {
  const last = acc.at(-1)
  if (last && last.hours === d.hours) return [...acc.slice(0, -1), { ...last, to: d.name, days: [...last.days, d.day] }]
  return [...acc, { from: d.name, to: d.name, hours: d.hours, days: [d.day] }]
}, [])
const short = (n: string) => n.slice(0, 3)
// Phone (base-site pattern): the week as short segments, e.g. "Mon to Fri 9 AM to 6 PM", "Sat 9 AM to 4 PM", "Sun Closed".
// Each segment is rendered unbreakable so a line never splits inside one.
const segments = (o: Office) => weekSummary(o).map(([days, hours]) => `${days.split(' to ').map(short).join(' to ')} ${hours}`)
---
<Section id="offices">
  <p class="eyebrow">Locations</p>
      <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">Our two offices</h2>
  <ul class="mt-6 grid gap-4 lg:mt-8 lg:grid-cols-2 lg:gap-6">
    {offices.map(o => {
      const place = o.neighborhood.split(',')[0]
      const docs = o.doctors.map(doctorBySlug).filter(d => d !== undefined)
      return (
      <li class="lift card-soft flex flex-col p-5 lg:p-6">
        <PhotoSlot fact={o.photo} shape="arch" class="h-[10rem] w-full lg:h-[12rem]" width={1056} height={520} />
        <div class="mt-4 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
          <h3 class="text-[1.29rem] leading-tight lg:text-[1.41rem]"><a href={`/locations/${o.slug}`} class="underline-offset-4 hover:underline">{o.name}</a></h3>
          <p class="rounded-full bg-mist px-3 py-1 text-[0.82rem] font-medium text-text"><OpenNow office={o} fallback="Hours below" /></p>
        </div>
        <div class="mt-4 lg:grid lg:grid-cols-[15rem_1fr] lg:gap-x-6">
          <div>
            <address class="not-italic">{o.addr.split(', ').slice(0, 1)}<br />{o.addr.split(', ').slice(1).join(', ')}</address>
            <ul class="mt-3 grid gap-2 text-[0.94rem] lg:hidden">
              <li class="flex gap-2.5"><span class="mt-0.5 shrink-0 text-teal-deep"><Icon name="clock" size={18} /></span><span class="tabular">{segments(o).map((seg, i) => (<>{i > 0 && ' · '}<span class="whitespace-nowrap">{seg}</span></>))}</span></li>
              {o.access.filter(a => isShown(a.fact)).map(a => (<li class="flex gap-2.5"><span class="mt-0.5 shrink-0 text-teal-deep"><Icon name="pin" size={18} /></span><span><span class="text-muted">{a.label}:</span> <FactSlot fact={a.fact} /></span></li>))}
            </ul>
            <a href={mapsHref(o.addr)} target="_blank" rel="noopener" aria-label={`Directions to the ${o.name} (opens Google Maps)`} class="arrow-link mr-5 inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">Directions<Icon name="arrow" size={18} /></a>
            <a href={`/locations/${o.slug}`} class="arrow-link inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4 lg:ml-0">Full week<span class="hidden lg:inline">&nbsp;and details</span><Icon name="arrow" size={18} /></a>
          </div>
          <div class="mt-3 hidden lg:mt-0 lg:block">
            <dl aria-label="Hours" class="tabular divide-y divide-line border-y border-line" data-week>
              {groups(o).map(g => (
                <div data-days={g.days.join(',')} class="flex min-h-10 items-center justify-between gap-3 rounded-lg px-2">
                  <dt>{g.from === g.to ? short(g.from) : `${short(g.from)} to ${short(g.to)}`}<span data-today-label class="ml-2 hidden font-semibold text-indigo">Today</span></dt>
                  <dd class="whitespace-nowrap font-semibold text-indigo">{g.hours}</dd>
                </div>
              ))}
            </dl>
            {o.access.some(a => isShown(a.fact)) && (
              <dl class="mt-3 text-[0.88rem]">
                {o.access.filter(a => isShown(a.fact)).map(a => (<div class="flex min-h-8 flex-wrap items-center gap-x-2"><dt class="text-muted">{a.label}</dt><dd><FactSlot fact={a.fact} /></dd></div>))}
              </dl>
            )}
          </div>
        </div>
        <p class="mt-2 hidden flex-wrap items-center gap-x-2 text-[0.82rem] lg:flex"><span class="text-muted">Doctors here:</span>{docs.map(d => (<a href={`/doctors/${d.slug}`} class="inline-flex min-h-11 items-center font-medium text-indigo underline underline-offset-4">{d.name.replace('Dr. ', 'Dr. ')}</a>))}</p>
        <div class="mt-auto pt-3 lg:pt-2">
          <a href={telHref(o.phone)} class="btn flex min-h-12 items-center justify-center gap-2 rounded-full border-[1.5px] border-muted font-semibold text-teal-deep hover:border-teal-deep"><Icon name="phone" size={18} />Call {place}<span class="tabular">{o.phone}</span></a>
        </div>
      </li>
    )})}
  </ul>
</Section>
<script>
  // Mark today's group in New York time (both offices are there). Without JS no row is marked.
  const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short' }).format(new Date()))
  document.querySelectorAll<HTMLElement>('[data-week] [data-days]').forEach(row => {
    if (!row.dataset.days?.split(',').includes(String(day))) return
    row.classList.add('bg-mist', 'font-semibold', 'text-indigo')
    row.setAttribute('aria-current', 'date')
    row.querySelector('[data-today-label]')?.classList.remove('hidden')
  })
</script>
