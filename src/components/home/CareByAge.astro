---
// Care by age (spec 4.8), the signature: the life stages hang on one teal line (one practice along a life).
// Vertical rail on phone, horizontal line across four columns on desktop. Each row names the doctor who leads it.
// Motion #7: the line draws (scaleY / scaleX) as it scrolls into view, CSS only, under @supports + no-preference.
// Reduced motion or no support: the full line, static. Nothing starts hidden but the decorative line itself.
// Data: ageBands (sample ranges; each doctor confirms them).
// Round 10 (design plan 4.3, desktop only; phone unchanged): from 64rem each stage is a card hanging from the line
// (.age-card is display: contents on phone, so the phone grid is untouched): a tall arch photo, the age range as a badge
// on a light tint (indigo text, AA), and "Led by" as doctor chips (round photo + name, 44 px tall, stacked). The node on
// the line fills teal. Hover/focus lifts the card. The line draw stays the page's one signature motion (U14.10).
import Section from '../Section.astro'
import PhotoSlot from '../PhotoSlot.astro'
import { ageBands, doctorBySlug, practice } from '../../data/practice'
---
<Section id="care" tone="white">
  <p class="eyebrow">Care by age</p>
      <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">Care by age</h2>
  <p class="mt-2 max-w-[44ch] text-[1rem] lg:mt-3 lg:text-[1.18rem]">Children can stay with the same practice as they grow, then move to adult care with us.</p>
  <ol class="age-line relative mt-5 grid gap-4 lg:mt-10 lg:grid-cols-4 lg:gap-6">
    <span aria-hidden="true" class="age-line__rule absolute bottom-6 left-[15px] top-2 w-0.5 bg-indigo/40 lg:inset-x-0 lg:bottom-auto lg:top-[5px] lg:h-0.5 lg:w-auto"></span>
    {ageBands.map(b => {
      const docs = b.doctors.map(doctorBySlug).filter(d => d !== undefined)
      return (
        <li class="age-stage relative grid grid-cols-[2rem_3.5rem_1fr] gap-x-3 lg:block">
          <span aria-hidden="true" class="age-node relative z-10 ml-[10px] mt-2 block size-3 rounded-t-full border-2 border-indigo bg-white lg:ml-0 lg:mt-0"></span>
          <div class="age-card contents">
          <PhotoSlot fact={b.photo} shape="arch" compact class="age-photo h-16 w-14 lg:h-[9rem] lg:w-full" width={480} height={360} />
          <div class="age-text lg:mt-4">
            <p class="age-range font-semibold text-indigo">{b.range}</p>
            <h3 class="text-[1.29rem] leading-tight lg:text-[1.41rem]">{b.title}</h3>
            <p class="mt-0.5 text-[0.94rem] leading-snug lg:mt-1 lg:text-base">{b.line}</p>
            <p class="age-led text-[0.82rem] lg:text-[0.88rem]"><span class="age-led__label">Led by </span>{docs.map((d, i) => (<>{i > 0 && <span class="age-or"> or </span>}<a href={`/doctors/${d.slug}`} class="age-chip inline-flex min-h-11 items-center font-medium text-teal-deep underline underline-offset-4"><img src={d.img} alt="" width="56" height="56" loading="lazy" class="age-chip__img hidden" />{d.name}</a></>))}</p>
          </div>
          </div>
        </li>
      )
    })}
  </ol>
  {practice.demo && <p class="mt-4 text-[0.82rem] text-muted">Sample ranges for the design demo. The doctors confirm every line before launch.</p>}
</Section>
<style>
  @media (min-width: 64rem) {
    .age-stage { display: flex; flex-direction: column; }
    .age-node { background: var(--color-teal-deep); border-color: var(--color-teal-deep); box-shadow: 0 0 0 4px #fff; }
    .age-card { position: relative; display: flex; flex: 1; flex-direction: column; margin-top: 1.4rem; padding: 1rem 1rem 1.25rem; border: 1px solid var(--color-line); border-radius: 1.5rem; background: #fff; box-shadow: 0 2px 8px rgb(23 18 58 / .05); }
    .age-card::before { content: ''; position: absolute; inset-block-start: -1.4rem; inset-inline-start: 5px; inline-size: 2px; block-size: 1.4rem; background: rgb(23 18 58 / .25); }
    .age-text { display: flex; flex: 1; flex-direction: column; margin-top: 1rem; padding-inline: .25rem; }
    .age-range { display: inline-flex; align-self: flex-start; margin-bottom: .5rem; padding: .3rem .75rem; border-radius: 999px; font-size: .82rem; background: var(--color-mist); }
    .age-stage:nth-child(2 of .age-stage) .age-range { background: #fbf0d9; }
    .age-stage:nth-child(3 of .age-stage) .age-range { background: #fde8eb; }
    .age-stage:nth-child(4 of .age-stage) .age-range { background: var(--color-lavender); }
    .age-led { display: flex; flex-direction: column; align-items: flex-start; gap: .4rem; margin-top: auto; padding-bottom: 0; padding-top: .9rem; border-top: 1px solid var(--color-line); }
    .age-text > p:nth-of-type(2) { margin-bottom: 1rem; }
    .age-led__label { font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--color-muted); }
    .age-or { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } /* visually hidden, still read */
    .age-chip { gap: .55rem; padding: .25rem .9rem .25rem .3rem; border: 1.5px solid rgb(11 111 111 / .45); border-radius: 999px; background: var(--color-cream); color: var(--color-teal-deep); } /* keeps the underline + a teal edge: reads as a link */
    .age-chip:hover { background: var(--color-mist); }
    .age-chip__img { display: block; inline-size: 2.25rem; block-size: 2.25rem; border-radius: 999px; object-fit: cover; }
  }
  @media (min-width: 64rem) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .age-card { transition: transform .35s var(--ease-soft), box-shadow .35s var(--ease-soft); }
    .age-card:is(:hover, :focus-within) { transform: translateY(-4px); box-shadow: var(--shadow-float); }
  }
</style>
