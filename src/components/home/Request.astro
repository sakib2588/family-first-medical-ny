---
import Icon from '../Icon.astro'
import RequestForm from '../RequestForm.astro'
---
<section id="request" class="px-5 py-14 md:px-8 md:py-20">
 <div class="mx-auto max-w-[1160px] md:grid md:grid-cols-2 md:gap-16">
 <div>
  <span class="mb-4 block h-1 w-10 rounded-full bg-gold" aria-hidden="true"></span>
  <h2 class="text-[1.9rem] md:text-4xl">Request a visit</h2>
  <p class="mt-3 md:text-lg">Tell us how to reach you. We will call you back within one business day to find a time.</p>
  <figure class="mt-8 rounded-3xl bg-white p-6">
    <div class="flex gap-1 text-gold" role="img" aria-label="Rated 5 out of 5 (sample rating)">
      {[0, 1, 2, 3, 4].map(() => (<Icon name="star" size={20} class="fill-current" />))}
    </div>
    <blockquote class="mt-3 text-[1.02rem] text-indigo">"Sample review text for layout only. Replace with an approved patient quote."</blockquote>
    <figcaption class="mt-3 text-sm text-muted">Sample patient · 5.0 average from sample reviews</figcaption>
  </figure>
 </div>
  <div class="mt-7 md:mt-0"><RequestForm /></div>
 </div>
</section>
