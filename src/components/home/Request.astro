---
const fieldClass = 'mt-1.5 block min-h-12 w-full rounded-xl border border-[#8b87a8] bg-white px-4 text-base text-indigo'
---
<section id="request" class="px-5 py-14 md:px-8 md:py-20">
 <div class="mx-auto max-w-[1160px] md:grid md:grid-cols-2 md:gap-16">
 <div>
  <span class="mb-4 block h-1 w-10 rounded-full bg-gold" aria-hidden="true"></span>
  <h2 class="text-[1.9rem] md:text-4xl">Request a visit</h2>
  <p class="mt-3 md:text-lg">Tell us how to reach you. We will call you back within one business day to find a time.</p>
 </div>
  <form id="request-form" class="mt-7 space-y-5 md:mt-0 md:max-w-md" novalidate>
    <div><label for="name" class="font-semibold text-indigo">Your name</label><input id="name" name="name" autocomplete="name" required class={fieldClass} /></div>
    <div><label for="phone" class="font-semibold text-indigo">Phone number</label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required class={fieldClass} /></div>
    <fieldset>
      <legend class="font-semibold text-indigo">Which office?</legend>
      <div class="mt-2 grid grid-cols-2 gap-3">
        <label class="flex min-h-12 cursor-pointer items-center justify-center rounded-xl border border-[#8b87a8] bg-white px-3 font-medium text-indigo has-[:checked]:border-teal-deep has-[:checked]:bg-teal-deep has-[:checked]:text-white"><input class="sr-only" type="radio" name="office" value="elmhurst" checked />Elmhurst</label>
        <label class="flex min-h-12 cursor-pointer items-center justify-center rounded-xl border border-[#8b87a8] bg-white px-3 font-medium text-indigo has-[:checked]:border-teal-deep has-[:checked]:bg-teal-deep has-[:checked]:text-white"><input class="sr-only" type="radio" name="office" value="hicksville" />Hicksville</label>
      </div>
    </fieldset>
    <div><label for="time" class="font-semibold text-indigo">Best time to call</label>
      <select id="time" name="time" class={fieldClass}><option>Morning</option><option>Afternoon</option><option>Evening</option></select></div>
    <p class="text-sm text-muted">Please do not include symptoms or medical details. For emergencies, call 911.</p>
    <button type="submit" class="btn inline-flex min-h-14 w-full items-center justify-center rounded-full bg-teal-deep text-lg font-semibold text-white hover:bg-teal-darker">Send request</button>
    <p id="request-status" role="status" class="min-h-6 text-[0.97rem] font-medium text-teal-deep"></p>
  </form>
 </div>
</section>
<script>
  const form = document.getElementById('request-form') as HTMLFormElement | null
  const status = document.getElementById('request-status')
  form?.addEventListener('submit', e => {
    e.preventDefault()
    if (!form.checkValidity()) { form.reportValidity(); return }
    if (status) status.textContent = 'Design demo: no request was sent.'
  })
  document.querySelectorAll('[data-visit]').forEach(a => a.addEventListener('click', () => { if (status) status.textContent = '' }))
</script>
