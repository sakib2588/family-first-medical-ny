---
// "See inside before you visit": the reference site's per-office gallery, as named photo slots until the client
// sends real photos with consent (rulebook U13, tell 2). The entrance photo is on each office card; this adds
// reception, waiting area and an exam room. The full set belongs on each location page.
import Section from '../Section.astro'
import PhotoSlot from '../PhotoSlot.astro'
import { offices, isShown } from '../../data/practice'
const withPhotos = offices.map(o => ({ o, photos: o.gallery.filter(isShown) })).filter(x => x.photos.length > 0)
---
{withPhotos.length > 0 && <Section id="inside" tone="white">
  <h2 class="text-[1.9rem] md:text-4xl">Inside each office</h2>
  <p class="mt-3 max-w-[40ch] md:text-lg">So you know which door to look for and what the rooms look like before your first visit.</p>
  <div class="mt-8 space-y-10 md:mt-12 md:grid md:grid-cols-2 md:gap-10 md:space-y-0">
    {withPhotos.map(({ o, photos }) => (
      <div>
        <h3 class="text-xl md:text-2xl"><a href={`/locations/${o.slug}`} class="underline-offset-4 hover:underline">{o.name}</a></h3>
        <div class="mt-4 grid grid-cols-3 gap-2.5 md:gap-3">
          {photos.map(g => (<PhotoSlot fact={g} compact class="aspect-[4/5]" />))}
        </div>
      </div>
    ))}
  </div>
</Section>}
