---
// Route by need right after the hero: two honest paths. A planned visit goes to the callback request;
// a sick visit goes to the call dialog, because a callback is too slow for someone who is sick today.
// The request form stays contact-only, so the visit reason is not carried into it (CLAUDE.md red line).
import Section from '../Section.astro'
import Icon from '../Icon.astro'
const tile = 'btn flex h-full min-h-32 flex-col items-start gap-2 rounded-2xl border bg-white p-5 md:p-7'
---
<Section id="visits" tone="lavender">
  <h2 class="text-[1.9rem] md:text-4xl">What brings you in?</h2>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2 md:mt-10 md:gap-5">
    <li><a href="#request" class={`${tile} border-line hover:border-teal-deep`}>
      <Icon name="calendar" size={24} class="text-teal-deep" />
      <span class="mt-1 font-display text-xl font-semibold text-indigo md:text-2xl">Planning a visit</span>
      <span class="text-[0.97rem] text-muted">Checkups, physicals, a new baby or vaccines. Send a short request and the office calls you back.</span>
    </a></li>
    <li><a href="/locations" data-call class={`${tile} border-teal-deep hover:bg-cream`}>
      <Icon name="phone" size={24} class="text-teal-deep" />
      <span class="mt-1 font-display text-xl font-semibold text-indigo md:text-2xl">Sick today</span>
      <span class="text-[0.97rem] text-muted">Call your office instead of sending a request. In an emergency, call 911.</span>
    </a></li>
  </ul>
</Section>
