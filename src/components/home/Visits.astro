---
// Visits + Sick today (spec 4.5): two paths. Planned visits go to the callback request; a sick visit is a call, so both
// offices are listed with their open status and number. No same-day claim. With JS the open office is listed first.
// Round 10 (design plan 4.1, owner: "mobile is ok, desktop is not"): PHONE UNCHANGED (same markup, rows not cards).
// Desktop (>= 64rem) only, all in the scoped @media block below: two equal-height cards with gradient icon tiles, a
// visit-type list read from serviceGroups (sample data, never typed here), the request link as an outlined button,
// office rows as name + live status | call button, and the open office ringed in teal (its dot pings twice, U14.8).
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import OpenNow from '../OpenNow.astro'
import { offices, telHref, serviceGroups } from '../../data/practice'
const archIcon = 'M5 21V11a7 7 0 0 1 14 0v10'
// Desktop-only list of common visit types, taken from the services sample (the doctors confirm it before launch).
const VISIT_TYPES = ['Well-child visits', 'Vaccines', 'Newborn care', 'Annual physicals'] as const
const visitTypes = serviceGroups.flatMap(g => g.items.map(([name]) => name)).filter(n => (VISIT_TYPES as readonly string[]).includes(n))
---
<Section id="visits">
  <p class="eyebrow">Your visit</p>
  <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">What brings you in?</h2>
  <div class="visits mt-6 grid gap-8 lg:mt-8 lg:grid-cols-2 lg:gap-6">
    <div class="visit-card visit-card--plan flex gap-4">
      <svg class="visit-icon visit-icon--plan size-10 shrink-0 text-indigo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={archIcon} /><path d="M9 15h6M12 12v6" /></svg>
      <div class="visit-body">
        <h3 class="text-[1.29rem] leading-tight lg:text-[1.41rem]">Planning a visit</h3>
        <p class="mt-1.5 max-w-[40ch]">Checkups, physicals, a new baby or vaccines. Leave your name and number and the office calls you back.</p>
        {visitTypes.length > 0 && (
          <ul class="visit-types hidden" aria-label="Common visits">
            {visitTypes.map(t => (<li><Icon name="check" size={16} />{t}</li>))}
          </ul>
        )}
        <a href="#request" class="visit-cta arrow-link mt-1 inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">Request a visit<Icon name="arrow" size={18} /></a>
      </div>
    </div>
    <div class="visit-card visit-card--sick flex gap-4">
      <svg class="visit-icon visit-icon--sick size-10 shrink-0 text-indigo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={archIcon} /><path d="M12 11v4M12 18h.01" /></svg>
      <div class="visit-body min-w-0 flex-1">
        <h3 class="text-[1.29rem] leading-tight lg:text-[1.41rem]">Sick today?</h3>
        <p class="mt-1.5 max-w-[40ch]">Call the office that is open now. In an emergency, call <strong class="font-semibold text-indigo">911</strong>.</p>
        <ul data-open-first class="office-rows -ml-14 mt-4 divide-y lg:ml-0 divide-line rounded-[1.25rem] border border-line bg-white px-4">
          {offices.map(o => (
            <li class="office-row py-3">
              <span><span class="block font-semibold text-indigo">{o.neighborhood.split(',')[0]}</span><OpenNow office={o} fallback="See hours below" class="block text-[0.88rem] leading-snug text-muted" /></span>
              <a href={telHref(o.phone)} aria-label={`Call ${o.neighborhood.split(',')[0]}, ${o.phone}`} class="office-call tabular mt-1 inline-flex min-h-11 items-center gap-2 whitespace-nowrap text-[1.12rem] font-semibold text-teal-deep underline underline-offset-4"><span class="office-call__icon hidden"><Icon name="phone" size={18} /></span>{o.phone}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Section>
<style>
  /* Desktop only (design plan 4.1). Nothing here applies below 64rem, so the phone layout is byte-for-byte the same. */
  @media (min-width: 64rem) {
    .visits { align-items: stretch; }
    .visit-card { flex-direction: column; gap: 1.25rem; padding: 2rem; border: 1px solid var(--color-line); border-radius: 1.5rem; background: #fff; box-shadow: 0 2px 8px rgb(23 18 58 / .05); }
    .visit-body { display: flex; flex: 1; flex-direction: column; }
    /* Colour grading (round 13, design-system audit: one colour role per card). Plan = teal family, Sick = rose
       family. Soft top glows, matching tags/rows and icon circles. Text contrast: indigo/text on white >= 10:1;
       #8f2a3f on #fde8eb 6.9:1; teal-deep on #e6f2f1 5.21:1. */
    .visit-card--plan { background: radial-gradient(120% 60% at 0% 0%, #dff0ee 0%, rgb(223 240 238 / 0) 60%), #fff; border-color: #cfe5e2; }
    .visit-card--sick { background: radial-gradient(120% 60% at 0% 0%, #fbe3e7 0%, rgb(251 227 231 / 0) 60%), #fff; border-color: #f1d3d9; }
    .visit-icon { inline-size: 3.5rem; block-size: 3.5rem; padding: .85rem; border-radius: 999px; box-shadow: none; }
    .visit-icon--plan { background: #fff; color: var(--color-teal-deep); box-shadow: 0 0 0 6px rgb(11 111 111 / .1); }
    .visit-icon--sick { background: #fff; color: #8f2a3f; box-shadow: 0 0 0 6px rgb(194 61 85 / .12); }
    .visit-types { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem 1rem; margin-block: 1.25rem 1.5rem; }
    .visit-types li { display: flex; align-items: center; gap: .6rem; border: 1px solid #cfe5e2; border-radius: .9rem; background: #fff; padding: .75rem .9rem; font-weight: 600; color: var(--color-indigo); box-shadow: 0 4px 12px -10px rgb(11 111 111 / .5); }
    .visit-types :global(svg) { flex: none; box-sizing: content-box; padding: .2rem; border-radius: 999px; background: var(--color-teal-deep); color: #fff; }
    .visit-cta { margin-top: auto; align-self: flex-start; min-height: 3rem; padding-inline: 1.5rem; border: 1.5px solid var(--color-muted); border-radius: 999px; text-decoration: none; }
    .visit-cta:hover { border-color: var(--color-teal-deep); background: var(--color-mist); }
    .office-rows { margin-top: 1.25rem; border: 0; background: none; padding: 0; display: grid; gap: .75rem; }
    .office-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem; border: 1.5px solid #f1d3d9; border-radius: 1rem; background: #fff; box-shadow: 0 4px 12px -10px rgb(143 42 63 / .45); }
    .office-row:has([data-state='open']) { border-color: var(--color-teal-deep); background: var(--color-mist); box-shadow: 0 0 0 4px rgb(11 111 111 / .1); }
    .office-call { margin-top: 0; min-height: 3rem; padding-inline: 1.1rem; border: 1.5px solid var(--color-muted); border-radius: 999px; background: #fff; text-decoration: none; font-size: 1.06rem; }
    .office-call:hover { border-color: var(--color-teal-deep); }
    .office-call__icon { display: inline-flex; }
  }
  @media (min-width: 64rem) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    .visit-card { transition: transform .35s var(--ease-soft), box-shadow .35s var(--ease-soft); }
    .visit-card:is(:hover, :focus-within) { transform: translateY(-3px); box-shadow: var(--shadow-float); }
  }
</style>
<script>import '../../scripts/open-first'</script>
