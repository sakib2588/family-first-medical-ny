---
// Doctors, person-first (spec 4.9): the face, who they see, the days at each office (a Fact slot the client
// confirms), a short blurb, then credentials: folded in <details> on phone, always visible on desktop. Every
// credential is a slot until checked against the public lookups in practice.ts (no "board-certified", no years,
// no "accepting new patients": CLAUDE.md red lines).
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import FactSlot from '../FactSlot.astro'
import { doctors, practice, isShown, officeBySlug } from '../../data/practice'
---
<Section id="doctors" tone="white">
  <div class="mx-auto max-w-[44rem] text-center">
    <p class="eyebrow">Our doctors</p>
    <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">Two doctors. <em class="font-medium text-teal-deep">One family practice.</em></h2>
    <p class="mt-3">One doctor for children and teens, one for adults, working side by side at both offices.</p>
  </div>
  <ul class="mt-8 grid gap-6 lg:mt-12">
    {doctors.map((d, i) => {
      const creds = [...d.credentials, { label: 'Languages', fact: d.languages }].filter(c => isShown(c.fact))
      const schedule = d.schedule.filter(s => isShown(s.days))
      return (
      <li data-reveal class="lift card-soft overflow-hidden lg:grid lg:grid-cols-[18rem_1fr]">
        <div class={`doc-side on-dark relative isolate grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 overflow-hidden p-5 text-on-dark lg:flex lg:flex-col lg:items-start lg:justify-between lg:gap-5 lg:p-6 ${i % 2 ? 'doc-side--b' : ''}`}>
          <img src={d.img} alt="" width="280" height="280" loading="lazy" class="col-start-2 row-span-3 size-28 rounded-full border-[5px] border-white/50 object-cover object-top shadow-[0_12px_30px_rgb(0_0_0/0.25)] lg:size-44" />
          <div class="col-start-1 row-start-1"><span class="block font-display text-[1.5rem] font-semibold leading-none text-white lg:text-[1.76rem]">{d.ages}</span><span class="mt-1 block text-[0.72rem] font-bold uppercase tracking-[0.14em]">Ages seen</span></div>
          <div class="col-start-1 row-start-2"><p class="font-display text-[1.18rem] font-semibold leading-tight text-white">{d.name}</p><p class="text-[0.72rem] font-bold uppercase tracking-[0.12em]">{d.role}</p></div>
          {practice.demo && <p class="col-start-1 row-start-3 text-[0.78rem] italic">Sample name and photo</p>}
        </div>
        <div class="p-5 lg:p-7">
          <h3 class="text-[1.41rem] leading-tight lg:text-[1.65rem]">{d.name}</h3>
          <p class="mt-0.5 font-semibold text-teal-deep">{d.role}</p>
          <p class="mt-3 border-b border-line pb-4">{d.blurb}</p>
          {schedule.length > 0 && (
            <dl aria-label={`Where and when ${d.name} sees patients`} class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 lg:gap-x-6">
              {schedule.map(sc => (<div><dt class="eyebrow">{officeBySlug(sc.office)?.neighborhood.split(',')[0]}</dt><dd class="mt-0.5 text-indigo"><FactSlot fact={sc.days} /></dd></div>))}
            </dl>
          )}
          {creds.length > 0 && (
            <dl aria-label={`Training and licence, ${d.name}`} class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 lg:gap-x-6">
              {creds.map(c => (<div><dt class="eyebrow">{c.label}</dt><dd class="mt-0.5 text-[0.94rem] text-indigo"><FactSlot fact={c.fact} /></dd></div>))}
            </dl>
          )}
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Care areas, ${d.name}`}>
            {d.careAreas.slice(0, 4).map(a => (<li class="rounded-full bg-mist px-3 py-1 text-[0.8rem] font-semibold text-teal-deep">{a}</li>))}
          </ul>
          <a href={`/doctors/${d.slug}`} class="arrow-link mt-4 inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">About {d.name}<Icon name="arrow" size={18} /></a>
        </div>
      </li>
    )})}
  </ul>
</Section>
