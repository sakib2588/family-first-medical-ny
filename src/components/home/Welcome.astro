---
// Welcome (round 8, owner: follow the base site's welcome pattern). A photo mosaic beside four benefit cards with
// gradient icon tiles and one wide card. Copy states only what the practice structure already shows: two specialties,
// two offices, the callback form, language help. No "open 7 days", "most insurance" or other unconfirmed claims.
// PHOTOS: stand-ins from public/demo (Unsplash); which real photo goes where: workspace/03-decisions/photo-map.md. Real practice photos replace them (03-decisions/2026-11-01-hero-photo-plan.md).
import Section from '../Section.astro'
import Icon from '../Icon.astro'
const mosaic = [
  { src: '/demo/child-joy.webp', alt: 'A smiling child', cls: 'row-span-2' },
  { src: '/demo/exam-room.webp', alt: 'A doctor talking with a patient', cls: '' },
  { src: '/demo/entrance-hicksville.webp', alt: 'An office building', cls: '' },
  { src: '/demo/adult-care.webp', alt: 'A blood pressure check', cls: 'col-span-2' },
]
// Round 12 (owner: "lacking content, looks AI written", compared with the base site): a real paragraph and four
// feature cards in a human voice. Each line is something the practice structure already shows (two specialties under
// one roof, two doctors, the services list); no hours, insurance, credentials or lab claims (red lines). The cards
// avoid repeating the hero chips. Soft tinted icon circles, not gradient tiles (an AI-design tell).
const features = [
  { icon: 'users', title: 'Care that grows with them', line: 'From first checkups to school physicals to adult care, without switching practices.' },
  { icon: 'heart', title: 'Doctors who know you', line: 'The same two doctors get to know your family, visit after visit.' },
  { icon: 'shield', title: 'Prevention first', line: 'Checkups, vaccines and screenings that catch problems early.' },
  { icon: 'chat', title: 'Plain answers', line: 'Clear explanations, so you leave knowing what comes next.' },
] as const
---
<Section id="welcome" tone="white">
  <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
    <ul class="grid grid-cols-2 gap-3 lg:col-span-5 lg:gap-4" aria-label="Photos of care">
      {mosaic.map(m => (
        <li data-reveal class={`overflow-hidden rounded-[1.25rem] shadow-[0_18px_40px_-22px_rgb(23_18_58/0.45)] ${m.cls}`}>
          <img src={m.src} alt={m.alt} width="600" height="600" loading="lazy" class={`size-full object-cover ${m.cls === 'col-span-2' ? 'aspect-[2/1]' : 'aspect-square'}`} />
        </li>
      ))}
    </ul>
    <div class="lg:col-span-7">
      <p class="eyebrow">Welcome</p>
      <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">A practice built around <em class="font-medium text-teal-deep">your family</em></h2>
      <p class="mt-3 max-w-[58ch] text-[1.02rem] leading-relaxed lg:text-[1.08rem]">AIMSS Family Health brings pediatrics and family medicine together under one roof. Your newborn, your teenager and you can all see doctors who already know the family, at offices in Elmhurst and Hicksville.</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:gap-4">
        {features.map(f => (
          <li data-reveal class="lift card-soft flex gap-3.5 p-4 sm:flex-col sm:gap-3 lg:p-5">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-mist text-teal-deep ring-4 ring-mist/50"><Icon name={f.icon} size={20} /></span>
            <div><h3 class="font-sans text-[1.02rem] font-bold leading-snug text-indigo">{f.title}</h3><p class="mt-1 text-[0.9rem] leading-snug text-muted">{f.line}</p></div>
          </li>
        ))}
        <li data-reveal class="lift card-soft flex items-center gap-4 p-4 sm:col-span-2 lg:p-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-teal-deep text-white"><Icon name="phone" size={20} /></span>
          <div class="flex-1"><h3 class="font-sans text-[1.02rem] font-bold leading-snug text-indigo">Book by phone</h3><p class="mt-0.5 text-[0.9rem] leading-snug text-muted">Call either office and the front desk finds you a time.</p></div>
          <a href="/locations" data-call class="arrow-link inline-flex min-h-11 shrink-0 items-center gap-1 font-semibold text-teal-deep underline underline-offset-4">Call<Icon name="arrow" size={18} /></a>
        </li>
      </ul>
    </div>
  </div>
</Section>
