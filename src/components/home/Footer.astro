---
// Footer (spec 4.14 + owner's phone fixes): compact. Offices side by side on phone (name, number, status), Explore and
// Policies as two-column link lists with 44 px rows, the 911 band kept, language help, DRAFT legal note.
// The closing call to action shows on inner pages only (Home has the request band right above).
import { practice, offices, legalPages, telHref, isShown } from '../../data/practice'
import { nav } from '../Header.astro'
import OpenNow from '../OpenNow.astro'
import FactSlot from '../FactSlot.astro'
import Logo from '../Logo.astro'
const link = 'inline-flex min-h-11 items-center underline-offset-4 hover:underline hover:text-white'
const h = 'font-sans text-[0.88rem] font-semibold text-white'
interface Props { closing?: boolean }
const { closing = true } = Astro.props
---
<footer id="site-footer" class="on-dark border-t border-indigo-soft bg-indigo px-5 pb-28 pt-8 text-[0.94rem] text-on-dark md:px-8 lg:pb-12 lg:pt-16">
  <div class="mx-auto max-w-[1160px]">
    {closing && (
      <div class="mb-10 flex flex-col gap-5 border-b border-indigo-soft pb-10 lg:flex-row lg:items-center lg:justify-between">
        <p class="font-display text-[1.76rem] font-medium leading-tight text-white">Your family's doctors, close to home.</p>
        <div class="flex flex-wrap gap-3">
          <a href="/contact" class="btn inline-flex min-h-12 items-center rounded-full bg-gold px-7 font-semibold text-indigo hover:bg-gold-light">Request a visit</a>
          <a href="/locations" data-call class="btn inline-flex min-h-12 items-center rounded-full border-[1.5px] border-on-dark px-7 font-semibold text-white hover:border-white">Call an office</a>
        </div>
      </div>
    )}
    <div class="grid gap-6 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-3">
        <Logo tone="dark" />
        <p class="mt-2 max-w-[30ch]">{practice.tagline}</p>
      </div>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-3 border-y border-indigo-soft py-4 lg:col-span-4 lg:border-0 lg:py-0" aria-label="Offices">
        {offices.map(o => (
          <li>
            <a href={`/locations/${o.slug}`} class={`${h} ${link} min-h-0`}>{o.neighborhood.split(',')[0]}</a>
            <a href={telHref(o.phone)} class="tabular flex min-h-11 items-center whitespace-nowrap font-semibold text-white underline decoration-aqua decoration-2 underline-offset-4">{o.phone}</a>
            <OpenNow office={o} fallback="Hours on the office page" class="block text-[0.82rem] leading-snug" />
          </li>
        ))}
      </ul>
      <nav id="site-nav" aria-label="Explore" class="lg:col-span-2">
        <h2 class={h}>Explore</h2>
        <ul class="mt-1 grid grid-cols-2 gap-x-4 lg:grid-cols-1">
          {[...nav, { label: 'Request a visit', href: '/#request' }].map(i => (<li><a href={i.href} class={link}>{i.label}</a></li>))}
        </ul>
      </nav>
      <nav aria-label="Policies" class="lg:col-span-3">
        <h2 class={h}>Policies</h2>
        <ul class="mt-1 grid grid-cols-2 gap-x-4">
          <li><a href="/legal" class={`${link} font-semibold`}>All policies</a></li>
          {legalPages.map(l => (<li><a href={`/legal/${l.slug}`} class={`${link} leading-tight`}>{l.short}</a></li>))}
        </ul>
      </nav>
    </div>
    <p class="mt-6 rounded-[1.25rem] bg-indigo-soft px-4 py-3 text-white lg:mt-8"><strong>In an emergency, call 911.</strong> <span class="text-on-dark">This website cannot give medical advice.</span></p>
    <p id="language-help" class="mt-4">Language help: <a href="/legal/nondiscrimination" class={`${link} text-white underline`}>Nondiscrimination and language help</a>{isShown(practice.languages) && <> · <FactSlot fact={practice.languages} /></>}</p>
    <p class="mt-2 text-[0.82rem]">© {new Date().getFullYear()} {practice.name}. This website does not replace a visit with your doctor.</p>
  </div>
</footer>
