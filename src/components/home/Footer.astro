---
const legal = ['Privacy policy', 'Notice of privacy practices', 'Terms of use', 'Accessibility', 'Nondiscrimination notice']
---
<footer id="site-footer" class="bg-indigo px-5 pb-28 pt-14 text-[0.97rem] text-[#e6e2f5] md:px-8 md:pb-14 md:pt-20"><div class="mx-auto max-w-[1160px]">
  <p class="font-display text-2xl font-semibold text-white">AIMSS Family Health</p>
  <p class="mt-1 text-[#c9c4e3]">Family medicine and pediatrics in Queens and Nassau County.</p>
  <div class="mt-8 grid gap-6 md:grid-cols-2 md:gap-12 md:max-w-3xl">
    <div><h2 class="font-sans text-sm font-semibold uppercase tracking-[0.12em] text-gold">Elmhurst</h2><p class="mt-1">123 Sample Street, Elmhurst, NY 11373</p><a class="inline-flex min-h-11 items-center font-semibold text-white underline underline-offset-4" href="tel:+17185550142">(718) 555-0142</a></div>
    <div><h2 class="font-sans text-sm font-semibold uppercase tracking-[0.12em] text-gold">Hicksville</h2><p class="mt-1">456 Example Avenue, Hicksville, NY 11801</p><a class="inline-flex min-h-11 items-center font-semibold text-white underline underline-offset-4" href="tel:+15165550188">(516) 555-0188</a></div>
  </div>
  <p class="mt-8 rounded-2xl border border-[#4a4378] p-4"><strong class="text-white">In an emergency, call 911.</strong> This website cannot give medical advice.</p>
  <ul class="mt-8 flex flex-wrap gap-x-5">
    {legal.map(l => (<li><a href="#site-footer" class="inline-flex min-h-11 items-center underline underline-offset-4">{l}</a></li>))}
  </ul>
  <p class="mt-6 text-sm text-[#b5b0d4]">Design demo with sample content and stand-in photos. Legal pages are drafts pending counsel. Last reviewed: sample date.</p>
</div></footer>
