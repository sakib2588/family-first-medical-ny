---
// Reviews (spec 4.11), honestly: per office a dated rating line as TEXT and a link to read every review on Google.
// No quotes until there is permission and a source, no stars, no "verified", no review or AggregateRating markup
// (CLAUDE.md red lines). Live: an office row shows only once its rating or profile link is confirmed.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import FactSlot from '../FactSlot.astro'
import { offices, isShown } from '../../data/practice'
const shown = offices.filter(o => isShown(o.googleRating) || isShown(o.googleProfile))
---
{shown.length > 0 && <Section id="reviews">
  <div class="lg:grid lg:grid-cols-12 lg:gap-x-6">
    <div class="lg:col-span-4">
      <p class="eyebrow">Reviews</p>
      <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">Reviews on Google</h2>
      <p class="mt-3 max-w-[36ch] text-[0.88rem]">Read what families say on Google, in full and unedited.</p>
    </div>
    <ul class="mt-6 divide-y divide-line rounded-[1.25rem] border border-line bg-white px-5 lg:col-span-7 lg:col-start-6 lg:mt-0">
      {shown.map(o => (
        <li class="flex min-h-[5.2rem] flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3">
          <div><p class="font-semibold text-indigo">{o.neighborhood.split(',')[0]}</p>{isShown(o.googleRating) && <p class="text-[0.88rem]"><FactSlot fact={o.googleRating} dated /></p>}</div>
          {o.googleProfile.value
            ? <a href={o.googleProfile.value} target="_blank" rel="noopener" class="arrow-link inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">Read reviews on Google<Icon name="arrow" size={18} /></a>
            : <span class="text-[0.88rem]">Read reviews on Google: <FactSlot fact={o.googleProfile} /></span>}
        </li>
      ))}
    </ul>
  </div>
</Section>}
