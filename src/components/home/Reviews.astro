---
// Reviews, honestly: a link to each office's Google profile. No quotes, stars, counts or "verified" until real
// reviews exist with source link, date and recorded permission (CLAUDE.md red line; decision round 3 #4).
// No AggregateRating markup. Single column, unlike Insurance next to it (Gate 9 item 7). Live: hidden until a link exists.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import FactSlot from '../FactSlot.astro'
import { offices, isShown } from '../../data/practice'
const shown = offices.filter(o => isShown(o.googleProfile))
---
{shown.length > 0 && <Section id="reviews">
  <h2 class="text-[1.9rem] md:text-4xl">What families say</h2>
  <p class="mt-3 max-w-[42ch] md:text-lg">Read reviews where families post them, in full and unedited.</p>
  <ul class="mt-4 flex flex-col gap-1 md:flex-row md:gap-10">
    {shown.map(o => (
      <li>{o.googleProfile.value
        ? <a href={o.googleProfile.value} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4">Reviews of the {o.name} on Google<Icon name="arrow" size={18} /></a>
        : <p class="py-1.5"><span class="font-medium text-indigo">{o.name}:</span> <FactSlot fact={o.googleProfile} /></p>}</li>
    ))}
  </ul>
</Section>}
