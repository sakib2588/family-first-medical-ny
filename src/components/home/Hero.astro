---
import Icon from '../Icon.astro'
const phone = '(516) 555-0142'
const proof = [
  { icon: 'check', label: 'Accepting new patients' },
  { icon: 'baby', label: 'Newborns through adults' },
  { icon: 'sun', label: 'Same-day sick visits' },
  { icon: 'pin', label: 'Two convenient offices' },
] as const
---
<section id="hero" class="overflow-hidden px-5 pb-10 pt-8 md:px-8 md:pb-16 md:pt-14">
  <div class="mx-auto max-w-[1160px] lg:grid lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-x-16">
    <div>
      <h1 class="max-w-[16ch] text-[2.35rem] sm:text-5xl lg:text-[3.6rem]">Family medicine and pediatrics, <em class="text-teal-deep">all in one place.</em></h1>
      <p class="mt-4 max-w-[34ch] text-[1.06rem] md:text-xl">Two doctors who know your family, from a baby's first checkup to your own annual physical.</p>
      <div class="mt-6 flex flex-col gap-3 md:flex-row md:items-center md:gap-6">
        <a href="#request" class="btn inline-flex min-h-14 items-center justify-center rounded-full bg-teal-deep px-8 text-lg font-semibold text-white hover:bg-teal-darker">Request a visit</a>
        <a href={`tel:+1${phone.replace(/\D/g, '')}`} class="inline-flex min-h-11 items-center justify-center gap-2 text-base font-semibold text-indigo underline decoration-gold decoration-2 underline-offset-4">
          <Icon name="phone" size={18} />Or call <span class="tabular">{phone}</span>
        </a>
      </div>
      <p class="mt-4 flex items-center justify-center gap-2 text-sm text-muted md:justify-start" aria-label="Today's status">
        <span class="size-2 rounded-full bg-teal-deep" aria-hidden="true"></span>Open today until 6 PM · Elmhurst office
      </p>
    </div>

    <div class="relative mt-10 lg:mt-0">
      <svg class="pointer-events-none absolute -inset-x-2 -top-4 h-[calc(100%+1rem)] w-[calc(100%+1rem)]" viewBox="0 0 400 480" preserveAspectRatio="none" aria-hidden="true"><path d="M2 478V210C2 96 92 2 200 2s198 94 198 208v268" fill="none" stroke="var(--color-gold)" stroke-width="1.5" vector-effect="non-scaling-stroke" opacity="0.75"/></svg>
      <div class="arch relative mx-auto aspect-[4/4.6] w-full max-w-sm bg-lavender md:max-w-md">
        <img src="/demo/child-joy.webp" alt="A smiling child outdoors with paint on her face (stand-in photo)" width="560" height="640" fetchpriority="high" class="size-full object-cover"/>
      </div>
      <a href="#doctors" class="absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-3 whitespace-nowrap rounded-full bg-white py-2 pl-2 pr-5 text-sm font-semibold text-indigo shadow-[0_10px_24px_-12px_rgb(23_18_58/0.45)] hover:text-teal-deep">
        <span class="flex -space-x-3" aria-hidden="true">
          <img src="/demo/doctor-female.webp" alt="" width="40" height="40" class="size-10 rounded-full border-2 border-white object-cover object-top"/>
          <img src="/demo/doctor-male.webp" alt="" width="40" height="40" class="size-10 rounded-full border-2 border-white object-cover object-top"/>
        </span>
        Meet our doctors
      </a>
    </div>
  </div>

  <ul class="mx-auto mt-10 grid max-w-[1160px] grid-cols-2 gap-x-4 gap-y-4 border-t border-line pt-6 text-[0.95rem] font-medium text-indigo md:grid-cols-4 md:text-base">
    {proof.map(p => (<li class="flex items-start gap-2.5"><Icon name={p.icon} size={20} class="mt-px shrink-0 text-teal-deep" /><span>{p.label}</span></li>))}
  </ul>
</section>
