---
// First phone screen answers: what (pediatrics + family medicine), for whom (newborns to adults),
// where (both offices, from practice.ts) and the one action (Request a visit). No proof claims:
// nothing is verified yet (workspace/03-decisions/2026-10-31-home-page-decisions.md #5).
import Icon from '../Icon.astro'
import { offices } from '../../data/practice'
const places = new Intl.ListFormat('en', { type: 'conjunction' }).format(offices.map(o => o.neighborhood.split(',')[0]))
---
<section id="hero" class="overflow-hidden px-5 pb-12 pt-8 md:px-8 md:pb-20 md:pt-14">
  <div class="mx-auto max-w-[1160px] lg:grid lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-x-16">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.12em] text-teal-deep">Pediatrics and family medicine</p>
      <h1 class="mt-3 max-w-[17ch] text-[2.5rem] leading-[1.08] sm:text-5xl lg:text-[3.75rem]">One practice for your <em class="text-teal-deep">whole family.</em></h1>
      <p class="mt-4 max-w-[34ch] text-[1.06rem] md:text-xl">Care for newborns, children, teens and adults, at our offices in {places}.</p>
      <div class="mt-7 flex flex-col gap-2 md:flex-row md:items-center md:gap-6">
        <a href="#request" class="btn inline-flex min-h-14 items-center justify-center rounded-full bg-teal-deep px-8 text-lg font-semibold text-white hover:bg-teal-darker">Request a visit</a>
        <a href="/locations" data-call class="inline-flex min-h-12 items-center justify-center gap-2 font-semibold text-indigo underline decoration-gold decoration-2 underline-offset-4 hover:text-teal-deep">
          <Icon name="phone" size={18} />Or call an office
        </a>
      </div>
    </div>

    <div class="relative mt-10 lg:mt-0">
      <svg class="pointer-events-none absolute -inset-x-2 -top-4 h-[calc(100%+1rem)] w-[calc(100%+1rem)]" viewBox="0 0 400 480" preserveAspectRatio="none" aria-hidden="true"><path d="M2 478V210C2 96 92 2 200 2s198 94 198 208v268" fill="none" stroke="var(--color-gold)" stroke-width="1.5" vector-effect="non-scaling-stroke" opacity="0.75"/></svg>
      <div class="arch relative mx-auto aspect-[4/4.2] w-full max-w-sm bg-lavender md:max-w-md">
        <img src="/demo/child-joy.webp" alt="A smiling child outdoors (stand-in photo)" width="560" height="640" fetchpriority="high" class="size-full object-cover"/>
      </div>
    </div>
  </div>
</section>
