---
// Indigo hero with the two doctors in the first screen (owner decision 2026-10-31-home-colour-and-hero.md).
// Three colours, one job each: indigo base, aqua accent (on indigo only), gold action on dark.
// Answers what, for whom, where (offices from practice.ts) and the one action. Name cards show
// name, role and ages only: no credentials until they are checked against the state board (red line).
import Icon from '../Icon.astro'
import { offices, doctors } from '../../data/practice'
const places = new Intl.ListFormat('en', { type: 'conjunction' }).format(offices.map(o => o.neighborhood.split(',')[0]))
---
<section id="hero" class="on-dark overflow-hidden bg-indigo px-5 pb-12 pt-9 text-on-dark md:px-8 md:pb-20 md:pt-16">
  <div class="mx-auto max-w-[1160px] lg:grid lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-x-16">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-aqua">Pediatrics and family medicine</p>
      <h1 class="mt-3 max-w-[17ch] text-[2.55rem] leading-[1.06] sm:text-5xl lg:text-[3.75rem]">One practice for your <em class="text-aqua">whole family.</em></h1>
      <p class="mt-4 max-w-[34ch] text-[1.06rem] md:text-xl">Care for newborns, children, teens and adults, at our offices in {places}.</p>
      <div class="mt-7 flex flex-col gap-2 md:flex-row md:items-center md:gap-6">
        <a href="#request" class="btn inline-flex min-h-14 items-center justify-center rounded-full bg-gold px-8 text-lg font-semibold text-indigo hover:bg-gold-light">Request a visit</a>
        <a href="/locations" data-call class="inline-flex min-h-12 items-center justify-center gap-2 font-semibold text-white underline decoration-aqua decoration-2 underline-offset-4 hover:text-aqua">
          <Icon name="phone" size={18} />Or call an office
        </a>
      </div>
    </div>

    <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-0" aria-label="Our doctors">
      {doctors.map((d, i) => (
        <li class="flex">
          <a href={`/doctors/${d.slug}`} class="group flex w-full flex-col rounded-[1.75rem]">
            <div class="arch aspect-[4/4.6] bg-indigo-soft"><img src={d.img} alt={d.alt} width="380" height="437" loading="eager" fetchpriority={i === 0 ? "high" : "auto"} class="size-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"/></div>
            <div class="relative -mt-6 mx-2 flex flex-1 flex-col justify-center rounded-2xl bg-white px-2.5 py-3 text-center shadow-[0_12px_28px_-16px_rgb(0_0_0/0.6)] sm:mx-3 sm:px-4">
              <p class="font-display text-[1.02rem] font-semibold leading-tight text-indigo [text-wrap:balance] sm:text-lg">{d.name}</p>
              <p class="mt-1 text-[0.8rem] font-semibold leading-snug text-teal-deep sm:text-sm">{d.role}</p>
              <p class="mt-0.5 text-[0.8rem] leading-snug text-muted sm:text-sm">{d.ages}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
