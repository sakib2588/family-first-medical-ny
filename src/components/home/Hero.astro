---
import Icon from '../Icon.astro'
const phone = '(516) 555-0142'
const chips = ['Accepting new patients', 'Newborns through adults', 'Same-day sick visits', 'Two convenient offices']
---
<section id="hero" class="overflow-hidden px-5 pb-12 pt-8 md:px-8 md:pb-20 md:pt-14">
  <div class="mx-auto grid max-w-[1160px] gap-y-9 lg:grid-cols-[1.05fr_1fr] lg:gap-x-16 lg:gap-y-10">
    <div class="lg:col-start-1 lg:row-start-1 lg:self-end">
      <h1 class="max-w-[16ch] text-[2.35rem] sm:text-5xl lg:text-[3.6rem]">Family medicine and pediatrics, <em class="text-teal-deep">all in one place.</em></h1>
      <p class="mt-4 max-w-[34ch] text-[1.06rem] md:text-xl">Two doctors who know your family, from a baby's first checkup to your own annual physical.</p>
      <div class="mt-6 flex flex-col gap-3 md:flex-row md:items-center md:gap-6">
        <a href="#request" class="btn inline-flex min-h-14 items-center justify-center rounded-full bg-teal-deep px-8 text-lg font-semibold text-white hover:bg-teal-darker">Request a visit</a>
        <a href={`tel:+1${phone.replace(/\D/g, '')}`} class="inline-flex min-h-11 items-center justify-center gap-2 text-base font-semibold text-indigo underline decoration-gold decoration-2 underline-offset-4">
          <Icon name="phone" size={18} />Or call <span class="tabular">{phone}</span>
        </a>
      </div>
      <p class="mt-4 flex items-center justify-center gap-2 text-sm text-muted md:justify-start" aria-label="Today's status">
        <span class="size-2 rounded-full bg-teal-deep" aria-hidden="true"></span>Open today until 6 PM · Elmhurst office
      </p>
    </div>

    <div class="relative lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
      <svg class="pointer-events-none absolute -inset-x-2 -top-4 h-[calc(100%+1rem)] w-[calc(100%+1rem)]" viewBox="0 0 400 480" preserveAspectRatio="none" aria-hidden="true"><path d="M2 478V210C2 96 92 2 200 2s198 94 198 208v268" fill="none" stroke="var(--color-gold)" stroke-width="1.5" vector-effect="non-scaling-stroke" opacity="0.75"/></svg>
      <div class="relative grid grid-cols-2 items-end gap-3 px-2 pt-4 md:gap-5 md:px-6" aria-label="Our doctors">
        <figure>
          <div class="arch aspect-[3/4.1] bg-lavender"><img src="/demo/doctor-female.webp" alt="Dr. Elena Park, family medicine (stand-in photo)" width="380" height="520" fetchpriority="high" class="size-full object-cover object-top"/></div>
          <figcaption class="mt-3 text-center"><span class="block font-display text-[1.05rem] font-semibold leading-tight text-indigo">Dr. Elena Park</span><span class="text-sm text-muted">Family medicine</span></figcaption>
        </figure>
        <figure class="pb-8 md:pb-12">
          <div class="arch aspect-[3/4.1] bg-lavender"><img src="/demo/doctor-male.webp" alt="Dr. Arjun Mehta, pediatrician (stand-in photo)" width="380" height="520" fetchpriority="high" class="size-full object-cover object-top"/></div>
          <figcaption class="mt-3 text-center"><span class="block font-display text-[1.05rem] font-semibold leading-tight text-indigo">Dr. Arjun Mehta</span><span class="text-sm text-muted">Pediatrics</span></figcaption>
        </figure>
      </div>
    </div>

    <ul class="grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-6 text-[0.95rem] font-medium text-indigo lg:col-start-1 lg:row-start-2 lg:self-start lg:text-base">
      {chips.map(c => (<li class="flex items-start gap-2"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-teal-deep" /><span>{c}</span></li>))}
    </ul>
  </div>
</section>
