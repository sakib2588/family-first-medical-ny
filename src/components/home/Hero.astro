---
// Hero, round 5 (owner request 2026-11-01): modelled on the reference site's top section, improved, not cloned.
// Light clinic ground (a soft CSS "reception" backdrop until the real office photo arrives), a big serif headline with
// one italic accent line in teal-deep and a gold underline, the two doctors side by side, white name cards below each
// photo, then one intro line and the one filled action. NO credentials ("board-certified") until checked (red line).
// PHOTO NOTES: see workspace/03-decisions/2026-11-01-hero-photo-plan.md (which real photo goes where).
import Icon from '../Icon.astro'
import { offices, doctors, serviceGroups, practice } from '../../data/practice'
const [first, second] = offices.map(o => o.neighborhood.split(',')[0])
// At-a-glance chips: only facts we hold (sample values are tagged in practice.ts). No "board-certified", "open 7 days",
// "accepting new patients" or "most insurance" until the client confirms them (red lines).
// Round 11 (owner: less writing, more dynamic, no repeats): the chips now say WHAT we treat (from serviceGroups);
// who / where / language / booking live in the trust band right below, so nothing repeats.
const CHIP_SERVICES = [['Newborn care', 'baby', 'tile-rose'], ['Vaccines', 'shield', 'tile-teal'], ['School and sports physicals', 'check', 'tile-gold'], ["Women's health", 'heart', 'tile-indigo']] as const
const offered = serviceGroups.flatMap(g => g.items.map(([name]) => name))
const chips = CHIP_SERVICES.filter(([name]) => offered.includes(name)).map(([text, icon, tile]) => ({ text: text === 'School and sports physicals' ? 'Physicals' : text, icon, tile }))
---
<section id="hero" class="relative isolate overflow-hidden bg-cream px-5 pb-10 pt-8 md:px-8 lg:pb-20 lg:pt-14">
  {/* Backdrop: stand-in for the reception photo (PHOTO 1). Decorative only. */}
  <img src="/demo/reception.webp" alt="" width="1200" height="800" loading="eager" class="pointer-events-none absolute inset-0 -z-20 size-full object-cover" />
  <div class="hero-room pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto max-w-[1160px] lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-8">
    <div class="lg:col-span-6">
      <ul class="mb-5 flex flex-wrap gap-2 whitespace-nowrap" aria-label="About the practice">
        <li class="pill"><Icon name="heart" size={15} class="text-teal-deep" />Every age</li>
        <li class="pill"><Icon name="pin" size={15} class="text-teal-deep" />{first} and {second}</li>
      </ul>
      <h1 class="text-[2.6rem] leading-[1.04] tracking-[-0.02em] text-indigo lg:text-[3.9rem]">Family medicine &amp; pediatrics, <br /><em class="brand-underline inline-block font-medium text-teal-deep">all in one place.</em></h1>
      <p class="mt-5 max-w-[42ch] text-[1.06rem] leading-normal text-text lg:text-[1.18rem]">One practice for your whole family, from the first checkup on. In {first} and {second}.</p>
      <div class="mt-6 grid grid-cols-[1fr_auto] gap-2.5 sm:flex sm:flex-wrap sm:gap-3">
        <a href="#request" class="btn btn-primary inline-flex min-h-[3.25rem] items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 text-[1rem] font-bold sm:px-7 sm:text-[1.02rem]">Request a visit<Icon name="arrow" size={18} /></a>
        <a href="#offices" class="btn btn-ghost inline-flex min-h-[3.25rem] items-center justify-center gap-1.5 whitespace-nowrap rounded-full px-4 text-[1rem] font-semibold sm:px-5 sm:text-[1.02rem]"><Icon name="pin" size={18} />Offices</a>
      </div>
      <ul class="mt-7 grid grid-cols-2 gap-2.5 lg:gap-3" aria-label="At a glance">
        {chips.map(c => (
          <li class="hero-chip card-soft flex min-h-[3.4rem] items-center gap-2.5 p-2 pr-3 lg:p-2.5">
            <span class={`tile ${c.tile} !size-9 !rounded-[0.7rem]`}><Icon name={c.icon} size={18} /></span>
            <span class="text-[0.9rem] font-semibold leading-tight text-indigo">{c.text}</span>
          </li>
        ))}
      </ul>
    </div>
    <ul class="mt-9 grid grid-cols-2 gap-3 lg:col-span-6 lg:mt-0 lg:gap-5" aria-label="Our doctors">
      {doctors.map((d, i) => (
        <li class="flex">
          <a href={`/doctors/${d.slug}`} class="lift group flex w-full flex-col rounded-[1.25rem]">
            <!-- PHOTO 2/3: real doctor portrait, waist up, plain clinic background, 4:5 -->
            <div class="hero-portrait aspect-[4/5] overflow-hidden rounded-t-[1.25rem]"><img src={d.img} alt={d.alt} width="500" height="625" loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} class="size-full object-cover object-top" /></div>
            <div class="relative -mt-6 flex-1 rounded-[1.25rem] bg-white p-4 shadow-[0_8px_24px_-12px_rgb(23_18_58/0.25)] lg:p-5">
              <p class="font-display text-[1.06rem] font-semibold leading-tight text-indigo group-hover:underline lg:text-[1.29rem]">{d.name}</p>
              <span class="mt-2 block h-[3px] w-10 rounded-full bg-gold" aria-hidden="true"></span>
              <p class="mt-2 text-[0.88rem] leading-snug text-muted">{d.role}</p>
              {practice.demo && <p class="mt-1 text-[0.78rem] italic leading-snug text-muted">Sample name and photo</p>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  /* Soft "reception" ground: warm wall, a ceiling glow and a wood panel, in CSS so there is no extra request. */
  .hero-room {
    background:
      radial-gradient(60% 35% at 70% 0%, rgb(255 255 255 / 0.95), transparent 70%),
      linear-gradient(180deg, transparent 55%, rgb(201 168 120 / 0.18) 55%, rgb(201 168 120 / 0.10) 100%),
      linear-gradient(180deg, rgb(250 247 239 / 0.86), rgb(250 247 239 / 0.94));
  }
  .hero-portrait { background: linear-gradient(180deg, #efe9dc, #e4dccb);
    -webkit-mask-image: linear-gradient(180deg, #000 85%, transparent);
            mask-image: linear-gradient(180deg, #000 85%, transparent); }
</style>
