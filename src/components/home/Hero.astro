---
// Hero, round 5 (owner request 2026-11-01): modelled on the reference site's top section, improved, not cloned.
// Light clinic ground (a soft CSS "reception" backdrop until the real office photo arrives), a big serif headline with
// one italic accent line in teal-deep and a gold underline, the two doctors side by side, white name cards below each
// photo, then one intro line and the one filled action. NO credentials ("board-certified") until checked (red line).
// PHOTO NOTES: see workspace/03-decisions/2026-11-01-hero-photo-plan.md (which real photo goes where).
import Icon from '../Icon.astro'
import { offices, doctors, practice } from '../../data/practice'
const [first, second] = offices.map(o => o.neighborhood.split(',')[0])
// At-a-glance chips: only facts we hold (sample values are tagged in practice.ts). No "board-certified", "open 7 days",
// "accepting new patients" or "most insurance" until the client confirms them (red lines).
// Round 12 (owner: competitor-style benefit lines; gradient icon tiles read as AI-made): short title-case benefits
// that are TRUE today (red lines: no board-certified / most insurance / open 7 days until the client confirms them;
// swap these lines when those facts are confirmed and dated in practice.ts). One soft teal tint, outline icons.
const chips = [
  { icon: 'users', text: 'Kids & Adults, One Team' },
  { icon: 'heart', text: practice.agesSeen.value ? practice.agesSeen.value.replace(/\b\w/g, ch => ch.toUpperCase()).replace(' To ', ' to ') : 'Care for Every Age' },
  { icon: 'globe', text: practice.languages.value ? `Care in ${practice.languages.value.replace(' and ', ' & ')}` : 'Language Help' },
  { icon: 'pin', text: 'Queens & Long Island Offices' },
] as const
---
<section id="hero" class="relative isolate overflow-hidden bg-cream px-5 pb-10 pt-8 md:px-8 lg:pb-20 lg:pt-14">
  {/* Backdrop: stand-in for the reception photo (PHOTO 1). Decorative only. */}
  <img src="/demo/reception.webp" alt="" width="1200" height="800" loading="eager" class="pointer-events-none absolute inset-0 -z-20 size-full object-cover" />
  <div class="hero-room pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  {/* Live colour field (three.js shader, wide desktop only; src/scripts/live3d.ts). Over the faded photo, under the text. */}
  <div data-live="hero" class="live-layer pointer-events-none absolute inset-0 -z-10 hidden" aria-hidden="true"><canvas class="size-full"></canvas></div>
  <div class="mx-auto max-w-[1160px] lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-8">
    <div class="lg:col-span-6">
      <p class="hero-pill inline-flex min-h-9 items-center gap-2 rounded-full bg-white px-3.5 text-[0.84rem] font-bold text-teal-deep shadow-[0_2px_10px_-4px_rgb(23_18_58/0.25)] ring-1 ring-line"><Icon name="heart" size={16} />{practice.agesSeen.value ? `Care from ${practice.agesSeen.value.toLowerCase()}` : 'Care for every age'}</p>
      <h1 class="mt-4 text-[2.6rem] max-[380px]:text-[2.3rem] leading-[1.04] tracking-[-0.02em] text-indigo lg:text-[3.9rem]">Family medicine <br />&amp; pediatrics, <br /><em class="brand-underline inline-block font-medium text-teal-deep">all in one place.</em></h1>
      <p class="mt-5 max-w-[42ch] text-[1.06rem] leading-normal text-text lg:text-[1.18rem]">One practice for your whole family, from the first checkup on. In {first} and {second}.</p>
      <div class="mt-6 grid gap-2.5 sm:flex sm:flex-wrap sm:gap-3">
        <a href="/locations" data-call class="btn btn-primary inline-flex min-h-[3.25rem] items-center justify-center gap-2 whitespace-nowrap rounded-full px-6 text-[1rem] font-bold sm:px-7 sm:text-[1.02rem]"><Icon name="phone" size={18} />Call to make an appointment</a>
        <a href="#offices" class="btn btn-ghost inline-flex min-h-[3.25rem] items-center justify-center gap-1.5 whitespace-nowrap rounded-full px-5 text-[1rem] font-semibold sm:text-[1.02rem]"><Icon name="pin" size={18} />Visit our offices</a>
      </div>
      <p class="mt-4 text-[0.95rem]"><a href="#request" class="inline-flex min-h-11 items-center font-semibold text-teal-deep underline underline-offset-4">Or request a visit online</a></p>
    </div>
    {/* Sample-style card: both doctors in one white card with the benefit lines underneath. */}
    <div class="hero-card mt-9 rounded-[1.75rem] bg-white/92 p-3 shadow-[0_28px_70px_-30px_rgb(23_18_58/0.4)] ring-1 ring-line sm:p-5 lg:col-span-6 lg:mt-0">
      <ul class="grid grid-cols-2 gap-3 lg:gap-5" aria-label="Our doctors">
        {doctors.map((d, i) => (
          <li class="flex">
            <a href={`/doctors/${d.slug}`} class="doc group flex w-full flex-col items-center text-center">
              {/* PHOTO 2/3: real doctor portrait, waist up, plain clinic background, 4:5 (workspace/03-decisions/photo-map.md #2, #3) */}
              <div class="doc__frame relative w-full">
                <div class={`doc__glow ${i === 0 ? 'doc__glow--teal' : 'doc__glow--gold'}`} aria-hidden="true"></div>
                <div class="hero-portrait arch relative aspect-[4/5] overflow-hidden ring-[6px] ring-white"><img src={d.img} alt="" width="500" height="625" loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} class="doc__img size-full object-cover object-top" /></div>
              </div>
              <p class="mt-4 font-display text-[1.12rem] font-semibold leading-tight text-indigo underline-offset-4 group-hover:underline lg:text-[1.35rem]">{d.name}</p>
              <p class="mt-1 text-[0.78rem] font-semibold uppercase leading-snug tracking-[0.08em] text-teal-deep lg:text-[0.82rem]">{d.role}</p>
            </a>
          </li>
        ))}
      </ul>
      <ul class="mt-5 grid grid-cols-2 gap-2.5 border-t border-line pt-4 lg:gap-3" aria-label="At a glance">
        {chips.map(c => (
          <li class="hero-chip flex min-h-[3.4rem] items-center gap-3 rounded-[1.1rem] bg-cream p-2 pr-3 lg:p-2.5 lg:pr-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-mist text-teal-deep"><Icon name={c.icon} size={18} /></span>
            <span class="text-[0.84rem] font-bold leading-tight text-indigo lg:text-[0.9rem]">{c.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  /* Soft "reception" ground: warm wall, a ceiling glow and a wood panel, in CSS so there is no extra request. */
  .hero-room {
    background:
      radial-gradient(60% 35% at 70% 0%, rgb(255 255 255 / 0.95), transparent 70%),
      linear-gradient(180deg, transparent 55%, rgb(201 168 120 / 0.18) 55%, rgb(201 168 120 / 0.10) 100%),
      linear-gradient(180deg, rgb(250 247 239 / 0.86), rgb(250 247 239 / 0.94));
  }
  .hero-portrait { background: linear-gradient(180deg, #efe9dc, #e4dccb);
    -webkit-mask-image: linear-gradient(180deg, #000 85%, transparent);
            mask-image: linear-gradient(180deg, #000 85%, transparent); }
  /* Doctor portraits (round 12): the AIMSS arch as the frame, a soft colour field behind it, a slight lift on hover. */
  .doc__glow { position: absolute; inset: 12% -6% -4%; border-radius: 999px 999px 2rem 2rem; opacity: .55; filter: blur(2px); }
  .doc__glow--teal { background: radial-gradient(80% 70% at 50% 40%, #bfe6e2, transparent 70%); }
  .doc__glow--gold { background: radial-gradient(80% 70% at 50% 40%, #f5e1b3, transparent 70%); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .doc__img { transition: transform .6s var(--ease-soft); }
    .doc:is(:hover, :focus-visible) .doc__img { transform: scale(1.04); }
  }
  @media (min-width: 80rem) { .live-layer { display: block; opacity: 0; transition: opacity 1.2s var(--ease-soft); } .live-layer[data-live-on] { opacity: .82; } }
</style>
<script>import '../../scripts/live3d'</script>
