---
// Insurance (spec 4.6), third on the page. A calm mist panel for Medicaid and Child Health Plus, a dated text list
// (no chips, no "& many more"), plans not taken and self-pay. No plan claim without a date (decision #8): every
// value is a Fact slot until the front desk confirms it. Call to check opens the call dialog.
// Round 10 (design plan 4.2, owner: desktop only; pills = owner's "do what a pro would do" -> base-site pattern):
// PHONE UNCHANGED (same markup). Desktop (>= 64rem), scoped @media below: the Medicaid / CHP fact becomes the one rich
// indigo-to-hero-teal panel (white text 9.95:1, on-dark 5.92:1), the right column a white panel with plans as plain
// text tags (tinted, square-ish, no border or shadow so they never read as buttons; no logos, no "& many more"; still a <ul>, still dated) and two icon tiles for the dated rows.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import FactSlot from '../FactSlot.astro'
import { practice, isShown } from '../../data/practice'
const { publicPlans, plans, notTaken, selfPay } = practice.insurance
const rows = ([{ label: 'Plans we do not take', fact: notTaken, icon: 'shield' }, { label: 'No insurance', fact: selfPay, icon: 'chat' }] as const).filter(r => isShown(r.fact))
---
<Section id="insurance" tone="white">
  <div class="lg:grid lg:grid-cols-12 lg:gap-x-6">
    <div class="ins-left lg:col-span-5">
      <p class="eyebrow">Insurance</p>
      <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">Insurance</h2>
      {isShown(publicPlans) && (
        <div class="ins-feature mt-5 rounded-[1.25rem] bg-mist p-4 lg:mt-8 lg:p-5">
          <span class="ins-feature__icon hidden"><Icon name="heart" size={22} /></span>
          <h3 class="text-[1.29rem] leading-tight lg:text-[1.41rem]">Medicaid and Child Health Plus</h3>
          <p class="ins-feature__fact mt-2 font-semibold text-indigo"><FactSlot fact={publicPlans} dated /></p>
        </div>
      )}
      <p class="ins-note mt-5 max-w-[44ch] text-[0.88rem]">Bring your insurance card and a photo ID.</p>
      <a href="/locations" data-call class="btn mt-4 inline-flex min-h-12 items-center gap-2 rounded-full border-[1.5px] border-muted px-6 font-semibold text-teal-deep hover:border-teal-deep"><Icon name="phone" size={18} />Call to check your plan</a>
    </div>
    <div class={`ins-panel mt-7 lg:col-span-6 lg:col-start-7 lg:mt-2 ${plans.value ? '' : 'ins-panel--compact'}`}>
      {(plans.value || practice.demo) && <h3 class="font-sans text-base font-semibold text-indigo">Other plans</h3>}
      {plans.value && plans.checkedOn
        ? <><ul class="ins-plans mt-2 grid grid-cols-2 gap-x-6 lg:grid-cols-3">{plans.value.map(p => (<li class="flex min-h-8 items-center border-b border-line text-[0.94rem] text-indigo lg:min-h-9 lg:text-base">{p}</li>))}</ul>
            <p class="mt-2 text-[0.82rem] text-muted">Checked {plans.checkedOn}.</p></>
        : practice.demo && <p class="mt-2 border-y border-line py-3"><span class="rounded-md bg-slot px-1.5 py-0.5 text-[0.88rem] font-medium text-slot-ink">[need: {plans.need}]</span></p>}
      {rows.length > 0 && (
        <dl class="ins-rows mt-4 divide-y divide-line border-b border-line">
          {rows.map(r => (<div class="ins-row flex min-h-11 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-2"><dt class="text-muted"><span class="ins-row__icon hidden"><Icon name={r.icon} size={20} /></span>{r.label}</dt><dd class="font-semibold text-indigo"><FactSlot fact={r.fact} dated /></dd></div>))}
        </dl>
      )}
    </div>
  </div>
</Section>
<style>
  /* Desktop only (design plan 4.2). Nothing applies below 64rem: the phone layout stays the same. */
  @media (min-width: 64rem) {
    .ins-feature { position: relative; overflow: hidden; padding: 2rem; border-radius: 1.5rem; color: #fff; background-image: linear-gradient(135deg, var(--color-indigo), var(--color-hero-teal)); box-shadow: 0 24px 48px -28px rgb(23 18 58 / .6); }
    .ins-feature::after { content: ''; position: absolute; inset: auto -3rem -5rem auto; inline-size: 13rem; block-size: 13rem; border: 2px solid rgb(255 255 255 / .12); border-radius: 999px 999px 0 0; pointer-events: none; }
    .ins-feature h3 { color: #fff; margin-top: 1rem; }
    .ins-feature__fact { color: var(--color-on-dark); font-size: 1.06rem; }
    .ins-feature__icon { display: grid; place-items: center; inline-size: 3rem; block-size: 3rem; border-radius: .9rem; background: rgb(255 255 255 / .12); color: #fff; }
    .ins-left { display: flex; flex-direction: column; align-items: flex-start; }
    .ins-left .ins-feature { flex: 1; align-self: stretch; } /* the panel grows so both columns end level */
    .ins-note { margin-top: 1.5rem; font-size: .94rem; }
    .ins-panel { align-self: stretch; padding: 2rem; border: 1px solid var(--color-line); border-radius: 1.5rem; background: var(--color-cream); }
    .ins-plans { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .9rem; }
    .ins-plans li { min-height: 2.5rem; padding-inline: 1rem; border: 0; border-radius: .6rem; background: var(--color-mist); font-weight: 600; cursor: default; } /* tags, not buttons: tinted, square-ish, no border, no hover */
    .ins-rows { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; margin-top: 1.75rem; border: 0; }
    .ins-rows > .ins-row { flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: .5rem; padding: 1.25rem; border: 1px solid var(--color-line); border-radius: 1.1rem; background: #fff; }
    .ins-row dt { display: flex; flex-direction: column; align-items: flex-start; gap: .75rem; font-weight: 600; color: var(--color-indigo); }
    .ins-row dd { font-weight: 500; color: var(--color-text); line-height: 1.45; }
    .ins-row__icon { display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem; border-radius: .7rem; background: var(--color-mist); color: var(--color-teal-deep); }
    /* Until the plan list is confirmed the panel holds only the self-pay tile: one wide tile, vertically centred. */
    .ins-panel--compact { align-self: start; margin-top: 6.35rem; padding: 0; border: 0; background: none; } /* top aligns with the Medicaid card */
    .ins-panel--compact .ins-rows { grid-template-columns: 1fr; margin-top: 0; }
    .ins-panel--compact .ins-row { padding: 2rem; border-radius: 1.5rem; box-shadow: 0 2px 8px rgb(23 18 58 / .05); }
  }
</style>
