---
import Section from '../Section.astro'
const plans = ['Medicaid', 'Medicare', 'Major commercial plans', 'Self-pay']
---
<Section id="insurance">
  <div class="md:grid md:grid-cols-[1fr_1.2fr] md:items-start md:gap-16">
    <div>
      <span class="mb-4 block h-1 w-10 rounded-full bg-gold" aria-hidden="true"></span>
      <h2 class="text-[1.9rem] md:text-4xl">Coverage made simple</h2>
      <p class="mt-3 md:text-lg">We accept most plans. Bring your card to your first visit and we will confirm your coverage with you.</p>
    </div>
    <div class="mt-6 md:mt-10">
      <ul class="flex flex-wrap gap-2 md:gap-3">
        {plans.map(p => (<li class="rounded-full border border-line bg-white px-4 py-2 text-[0.97rem] font-medium text-indigo md:px-5 md:py-3 md:text-lg">{p}</li>))}
      </ul>
      <p class="mt-4 text-sm text-muted">Sample list for the design demo. The real list will show the date it was last confirmed.</p>
    </div>
  </div>
</Section>
