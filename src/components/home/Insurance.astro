---
// Insurance (spec 4.6), round 12 (owner: "needs better planning, content and design"). One idea: insurance made simple.
// Left: the heading, one line and the call button. Right: one card with three numbered things to know. Every value
// is a Fact from practice.ts; no plan list, plans-not-taken or "most insurance" until the front desk confirms them
// (red lines). When the plan list is confirmed (with a date) it appears as plain tags under the card, automatically.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import FactSlot from '../FactSlot.astro'
import { practice, isShown } from '../../data/practice'
const { publicPlans, plans, notTaken, selfPay } = practice.insurance
const items = [
  { icon: 'shield', title: 'Medicaid & Child Health Plus', fact: publicPlans },
  { icon: 'chat', title: 'Paying yourself', fact: selfPay },
  { icon: 'check', title: 'What to bring', text: 'Your insurance card and a photo ID.' },
  { icon: 'pin', title: 'Plans we do not take', fact: notTaken },
].filter(i => i.text || (i.fact && isShown(i.fact))) as { icon: 'shield' | 'chat' | 'check' | 'pin'; title: string; fact?: typeof publicPlans; text?: string }[]
---
<Section id="insurance" tone="white">
  <div class="ins grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-x-10">
    <div class="lg:col-span-5">
      <p class="eyebrow">Insurance</p>
      <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">Insurance, <em class="font-medium text-teal-deep">made simple.</em></h2>
      <p class="mt-3 max-w-[38ch] text-[1.02rem] lg:text-[1.12rem]">Here's what to know before your visit. One quick call confirms your coverage.</p>
      <a href="/locations" data-call class="btn btn-ghost mt-6 inline-flex min-h-12 items-center gap-2 rounded-full px-6 font-semibold"><Icon name="phone" size={18} />Call to check your plan</a>
    </div>
    <div class="lg:col-span-7">
      <ol class="ins-list card-soft">
        {items.map((it, i) => (
          <li data-reveal class="ins-item">
            <span class="ins-item__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="min-w-0">
              <h3 class="flex items-center gap-2 font-sans text-[1.02rem] font-bold text-indigo"><Icon name={it.icon} size={18} class="text-teal-deep" />{it.title}</h3>
              <p class="mt-1 text-[0.94rem] leading-snug">{it.text ?? <FactSlot fact={it.fact!} dated />}</p>
            </div>
          </li>
        ))}
      </ol>
      {plans.value && plans.value.length > 0 && (
        <div class="mt-5">
          <h3 class="font-sans text-[0.88rem] font-semibold text-muted">Plans we take{plans.checkedOn && plans.checkedOn !== 'sample date' && ` (checked ${plans.checkedOn})`}</h3>
          <ul class="mt-2 flex flex-wrap gap-2">{plans.value.map(p => (<li class="rounded-[.6rem] bg-mist px-3 py-1.5 text-[0.88rem] font-semibold text-indigo">{p}</li>))}</ul>
        </div>
      )}
    </div>
  </div>
</Section>
<style>
  .ins-list { padding: .5rem 1.25rem; }
  .ins-item { display: flex; gap: 1rem; padding-block: 1.1rem; }
  .ins-item + .ins-item { border-top: 1px solid var(--color-line); }
  .ins-item__n { flex: none; inline-size: 2.25rem; padding-top: .1rem; font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; line-height: 1; color: var(--color-teal-deep); font-variant-numeric: tabular-nums; }
  @media (min-width: 64rem) {
    .ins-list { padding: .75rem 2rem; border-radius: 1.5rem; box-shadow: 0 24px 48px -32px rgb(23 18 58 / .35); }
    .ins-item { padding-block: 1.4rem; gap: 1.5rem; }
    .ins-item__n { font-size: 1.8rem; inline-size: 3rem; }
  }
  /* Motion (owner round 13; transform/opacity/colour only; off under reduced motion; loop stops with Pause motion).
     Reveal: rows slide in from the right in sequence and the number pops. Hover: the row lights up. */
  .ins-item { position: relative; border-radius: 1rem; transition: background-color var(--m-normal, .35s); }
  .ins-item__n { display: inline-block; transform-origin: left center; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ins-item.reveal:not(.in) { transform: translateX(28px); }
    :global(.js) .ins-item.in .ins-item__n { animation: ins-pop .6s var(--ease-bounce, cubic-bezier(.34, 1.56, .64, 1)) both; animation-delay: calc(var(--rd, 0s) + .15s); }
    @keyframes ins-pop { from { transform: scale(.5); opacity: 0; } }
    .ins-item:hover .ins-item__n { transform: translateX(4px) scale(1.08); transition: transform .3s var(--ease-soft); }
  }
  .ins-list { isolation: isolate; }
</style>
