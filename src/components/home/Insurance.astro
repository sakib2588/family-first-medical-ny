---
// Owner decision #8: no plan list until the client sends one with a date. Until then: call to check.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
---
<Section id="insurance" tone="white">
  <div class="md:grid md:grid-cols-[1fr_1.2fr] md:items-center md:gap-16">
    <h2 class="text-[1.9rem] md:text-4xl">Insurance</h2>
    <div class="mt-3 md:mt-0">
      <p class="max-w-[40ch] md:text-lg">To check whether we take your plan, call your office before your first visit. Bring your insurance card and a photo ID when you come in.</p>
      <a href="/locations" data-call class="btn mt-5 inline-flex min-h-12 items-center gap-2 rounded-full border-2 border-teal-deep px-6 font-semibold text-teal-deep hover:bg-teal-deep hover:text-white"><Icon name="phone" size={18} />Call to check your plan</a>
    </div>
  </div>
</Section>
