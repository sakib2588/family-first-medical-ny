---
import Section from '../Section.astro'
---
<Section id="about" tone="lavender">
  <div class="md:grid md:grid-cols-2 md:items-center md:gap-16">
    <div>
      <span class="mb-4 block h-1 w-10 rounded-full bg-gold" aria-hidden="true"></span>
      <h2 class="text-[1.9rem] md:text-4xl">A practice built around your family</h2>
      <p class="mt-4 md:text-lg">One practice for every age means one team that knows your history, your questions and your schedule. Parents, kids and grandparents can book the same week, at the same office.</p>
    </div>
    <div class="arch mx-auto mt-8 aspect-[4/4.4] w-full max-w-md bg-white md:mt-0"><img src="/demo/hands.webp" alt="Two people holding hands in a moment of comfort (stand-in photo)" width="640" height="700" loading="lazy" class="size-full object-cover"/></div>
  </div>
</Section>
