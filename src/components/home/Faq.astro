---
// Only answers that hold today. No "accepting new patients" and no same-day promise until the client confirms.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
const faqs = [
  ['Who sees children, and who sees adults?', 'Our pediatrician cares for newborns, children and teens. Our family physician cares for teens and adults.'],
  ['How do I book a first visit?', 'Send a visit request with your name and phone number, or call the office you prefer. The office calls you back during office hours to set a time.'],
  ['What if someone is sick today?', 'Call your office and tell the front desk. In an emergency, call 911.'],
  ['Do you take my insurance?', 'Call your office to check before your first visit, and bring your insurance card when you come in.'],
  ['What should I bring?', 'A photo ID, your insurance card, a list of the medicines you take, and any past records. For a child, bring their vaccine record too.'],
] as const
---
<Section id="faq">
  <div class="md:grid md:grid-cols-[1fr_1.7fr] md:gap-16">
    <h2 class="text-[1.9rem] md:text-4xl">Common questions</h2>
    <div class="mt-6 divide-y divide-line border-y border-line md:mt-2">
      {faqs.map(([q, a]) => (
        <details class="group py-1">
          <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 py-2 text-[1.02rem] font-semibold text-indigo md:text-lg">{q}<Icon name="plus" size={20} class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" /></summary>
          <p class="pb-4 pr-8 text-[0.97rem] md:text-base">{a}</p>
        </details>
      ))}
    </div>
  </div>
</Section>
