---
// FAQ (spec 4.12): left-aligned, native <details>. Only answers that hold today; anything that needs a client fact
// is a Fact slot (no invented policy, no "accepting new patients" or same-day promise until confirmed and dated).
// Motion #6: the answer fades and rises 4 px on open; height is never animated; reduced motion is instant.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import FactSlot from '../FactSlot.astro'
import { practice, type Fact } from '../../data/practice'
type Item = { q: string; a: string; fact?: Fact<string>; dated?: boolean }
const faqs: Item[] = [
  { q: 'How do I book a first visit?', a: 'Send a visit request with your name and phone number, or call the office you prefer. The office calls you back during office hours to set a time.' },
  { q: 'Are you taking new patients?', a: 'New patients:', fact: practice.acceptingNew, dated: true },
  { q: 'Who sees children, and who sees adults?', a: 'Our pediatrician cares for newborns, children and teens. Our family physician cares for teens and adults.' },
  { q: 'What if someone is sick today?', a: 'Call your office and tell the front desk. In an emergency, call 911.' },
  { q: 'What happens after hours?', a: 'In an emergency, call 911. After hours:', fact: practice.afterHours },
  { q: 'How do I get my records?', a: 'Records:', fact: practice.records },
  { q: 'Can I get help in my language?', a: 'Language help:', fact: practice.languages },
]
const shown = faqs.filter(f => !f.fact || f.fact.value !== null || practice.demo)
---
<Section id="faq" tone="white">
  <div class="lg:grid lg:grid-cols-12 lg:gap-x-6">
    <div class="lg:col-span-4">
      <p class="eyebrow">Questions</p>
      <h2 class="mt-2 text-[1.76rem] leading-[1.12] lg:text-[2.47rem]">Questions</h2>
    </div>
    <div class="mt-6 divide-y divide-line border-y border-line lg:col-span-7 lg:col-start-6 lg:mt-0">
      {shown.map(f => (
        <details class="faq group">
          <summary class="flex min-h-[3.5rem] cursor-pointer items-center justify-between gap-4 py-2 font-display text-[1.12rem] font-medium leading-snug text-indigo">{f.q}<Icon name="plus" size={20} class="shrink-0 text-muted transition-transform group-open:rotate-45" /></summary>
          <p class="faq__answer max-w-[64ch] pb-4 pr-8">{f.a}{f.fact && <> <FactSlot fact={f.fact} dated={f.dated} /></>}</p>
        </details>
      ))}
    </div>
  </div>
</Section>
