---
import Section from '../Section.astro'
const ages = [
  { name: 'Newborns', range: 'Birth to 12 months' },
  { name: 'Children', range: '1 to 12 years' },
  { name: 'Teens', range: '13 to 21 years' },
  { name: 'Adults and seniors', range: '22 and up' },
]
---
<Section id="ages" tone="indigo">
  <div class="md:grid md:grid-cols-[1fr_1.1fr] md:items-center md:gap-16">
    <div class="arch mx-auto aspect-[4/4.6] w-full max-w-sm bg-indigo-soft md:max-w-md"><img src="/demo/child-play.webp" alt="A young child playing with a purple toy camera in a bright classroom (stand-in photo)" width="560" height="640" loading="lazy" class="size-full object-cover"/></div>
    <div class="mt-9 md:mt-0">
      <span class="mb-4 block h-1 w-10 rounded-full bg-gold" aria-hidden="true"></span>
      <h2 class="text-[1.9rem] md:text-4xl">Care for every age</h2>
      <p class="mt-4 md:text-lg">The same familiar faces from the first checkup through the years that follow, so your family does not have to start over with someone new.</p>
      <ul class="mt-6 border-t border-[#5b5399]">
        {ages.map(a => (<li class="flex items-baseline justify-between gap-4 border-b border-[#5b5399] py-3.5"><span class="font-semibold text-white">{a.name}</span><span class="tabular text-sm text-gold">{a.range}</span></li>))}
      </ul>
    </div>
  </div>
</Section>
