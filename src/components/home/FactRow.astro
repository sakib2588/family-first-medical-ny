---
// Fact row (spec 4.4): white band right under the hero. Facts as data with a date or a labelled slot: insurance
// first, ages, then a Google rating per office as dated text. No stars, no AggregateRating, no "years" or
// "board-certified" (CLAUDE.md red lines). Live: unconfirmed cells are hidden.
import FactSlot from '../FactSlot.astro'
import { practice, offices, isShown, type Fact } from '../../data/practice'
const confirmed = (value: string): Fact<string> => ({ value, need: '' })
const cells = [
  { label: 'Medicaid and Child Health Plus', fact: practice.insurance.publicPlans, dated: true },
  { label: 'Ages we see', fact: confirmed('Newborns to adults'), dated: false },
  ...offices.map(o => ({ label: `${o.neighborhood.split(',')[0]} on Google`, fact: o.googleRating, dated: true })),
].filter(c => isShown(c.fact))
---
{cells.length > 0 && (
<section aria-label="Key facts" class="bg-white px-5 py-6 md:px-8 lg:py-10">
  <dl class="mx-auto grid max-w-[1160px] grid-cols-2 lg:grid-cols-4">
    {cells.map((c, i) => (
      <div class={`min-h-[7.25rem] py-4 ${i % 2 === 0 ? 'pr-4' : 'border-l border-line pl-4'} ${i >= 2 ? 'border-t border-line lg:border-t-0' : ''} ${i > 0 ? 'lg:border-l lg:pl-6' : ''} lg:min-h-0`}>
        <dt class="text-[0.82rem] font-medium leading-snug text-muted">{c.label}</dt>
        <dd class="mt-1.5 font-semibold text-indigo"><FactSlot fact={c.fact} dated={c.dated} /></dd>
      </div>
    ))}
  </dl>
</section>)}
