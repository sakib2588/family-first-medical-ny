---
// Fact row (spec 4.4), round 7 (owner 2026-11-01: "more animated"): four cards right under the hero. Round 8: a dark photo band
// with four glass cards (base-site trust strip pattern); each icon tile pops and its icon draws itself, staggered by the shared reveal script in
// Base.astro. CSS only (no animation library, project rule); everything static under reduced motion or without JS.
// Facts as data with a date or a labelled slot. No stars, no AggregateRating, no "years" or "board-certified" (red lines).
import FactSlot from '../FactSlot.astro'
import Icon from '../Icon.astro'
import { practice, offices, isShown } from '../../data/practice'
const cells = [
  { label: 'Medicaid and Child Health Plus', icon: 'shield', fact: practice.insurance.publicPlans, dated: true },
  { label: 'Ages we see', icon: 'heart', fact: practice.agesSeen, dated: false },
  ...offices.map(o => ({ label: `${o.neighborhood.split(',')[0]} on Google`, icon: 'pin', fact: o.googleRating, dated: true })),
].filter(c => isShown(c.fact)) as { label: string; icon: 'shield' | 'heart' | 'pin'; fact: typeof practice.agesSeen; dated: boolean }[]
---
{cells.length > 0 && (
<section aria-label="Key facts" class="on-dark relative isolate overflow-hidden bg-indigo px-5 py-8 text-on-dark md:px-8 lg:py-10">
  <img src="/demo/child-play.webp" alt="" width="1200" height="800" loading="lazy" class="pointer-events-none absolute inset-0 -z-20 size-full object-cover" />
  <div class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-r from-indigo/95 via-indigo/85 to-hero-teal/90" aria-hidden="true"></div>
  <dl class="mx-auto grid max-w-[1160px] gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
    {cells.map((c, i) => (
      <div data-reveal class="fact glass flex items-start gap-3 p-4">
        <span class={`fact__icon tile ${['tile-teal', 'tile-gold', 'tile-rose', 'tile-indigo'][i % 4]}`}><Icon name={c.icon} size={20} draw /></span>
        <div class="min-w-0">
          <dt class="font-semibold leading-snug text-white">{c.label}</dt>
          <dd class="mt-0.5 text-[0.88rem] leading-snug text-on-dark"><FactSlot fact={c.fact} dated={c.dated} /></dd>
        </div>
      </div>
    ))}
  </dl>
</section>)}
<style is:global>
  /* Reveal choreography (only under html.js, never with reduced motion): card rises, tile pops, icon draws. */
  .js .fact.reveal { transform: translateY(18px) scale(.97); }
  .js .fact .fact__icon { transform: scale(.6) rotate(-12deg); }
  .js .fact.in .fact__icon { transform: none; transition: transform .6s cubic-bezier(.34, 1.56, .64, 1) calc(var(--rd, 0s) + .15s); }
  .js .fact path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .js .fact.in path { stroke-dashoffset: 0; transition: stroke-dashoffset .9s cubic-bezier(.2, .7, .2, 1) calc(var(--rd, 0s) + .3s); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .fact { transition: border-color .35s, background-color .35s; }
    .fact:hover { border-color: rgb(255 255 255 / .4); background-color: rgb(23 18 58 / .6); }
  }
</style>
