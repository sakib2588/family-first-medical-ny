---
// Fact row (spec 4.4), round 7 (owner 2026-11-01: "more animated"): four cards right under the hero. Each card has an
// icon that draws itself, then the card pops in with a short light sweep, staggered by the shared reveal script in
// Base.astro. CSS only (no animation library, project rule); everything static under reduced motion or without JS.
// Facts as data with a date or a labelled slot. No stars, no AggregateRating, no "years" or "board-certified" (red lines).
import FactSlot from '../FactSlot.astro'
import Icon from '../Icon.astro'
import { practice, offices, isShown } from '../../data/practice'
const cells = [
  { label: 'Medicaid and Child Health Plus', icon: 'shield', fact: practice.insurance.publicPlans, dated: true },
  { label: 'Ages we see', icon: 'heart', fact: practice.agesSeen, dated: false },
  ...offices.map(o => ({ label: `${o.neighborhood.split(',')[0]} on Google`, icon: 'pin', fact: o.googleRating, dated: true })),
].filter(c => isShown(c.fact)) as { label: string; icon: 'shield' | 'heart' | 'pin'; fact: typeof practice.agesSeen; dated: boolean }[]
---
{cells.length > 0 && (
<section aria-label="Key facts" class="bg-white px-5 py-8 md:px-8 lg:py-12">
  <dl class="mx-auto grid max-w-[1160px] grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-5">
    {cells.map((c, i) => (
      <div data-reveal class={`fact relative overflow-hidden rounded-[1.25rem] border border-line p-4 lg:p-5 ${i % 2 ? 'bg-mist/60' : 'bg-cream'}`}>
        <span class="fact__icon grid size-11 place-items-center rounded-full bg-white text-teal-deep shadow-[0_6px_16px_-8px_rgb(11_111_111/0.5)]"><Icon name={c.icon} size={22} draw /></span>
        <dt class="mt-3 text-[0.8rem] font-medium leading-snug text-muted">{c.label}</dt>
        <dd class="mt-1 text-[0.94rem] font-semibold leading-snug text-indigo"><FactSlot fact={c.fact} dated={c.dated} /></dd>
      </div>
    ))}
  </dl>
</section>)}
<style is:global>
  /* Reveal choreography (only when the reveal script runs: html.js; never under reduced motion). */
  .js .fact.reveal { transform: translateY(18px) scale(.96); }
  .js .fact.reveal.in { transform: none; }
  .js .fact .fact__icon { transform: scale(.6) rotate(-12deg); }
  .js .fact.in .fact__icon { transform: none; transition: transform .6s cubic-bezier(.34, 1.56, .64, 1) calc(var(--rd, 0s) + .15s); }
  .js .fact path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .js .fact.in path { stroke-dashoffset: 0; transition: stroke-dashoffset .9s cubic-bezier(.2, .7, .2, 1) calc(var(--rd, 0s) + .3s); }
  /* One light sweep across the card as it lands. */
  .js .fact::after { content: ''; position: absolute; inset: 0; pointer-events: none; transform: translateX(-120%);
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / .75) 50%, transparent 65%); }
  .js .fact.in::after { transform: translateX(120%); transition: transform 1.1s cubic-bezier(.2, .7, .2, 1) calc(var(--rd, 0s) + .35s); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .fact { transition: box-shadow .35s cubic-bezier(.2, .7, .2, 1), border-color .35s; }
    .js .fact.reveal.in { transition: opacity .7s cubic-bezier(.2, .7, .2, 1) var(--rd, 0s), transform .7s cubic-bezier(.2, .7, .2, 1) var(--rd, 0s), box-shadow .35s cubic-bezier(.2, .7, .2, 1), border-color .35s; }
    .fact:hover { box-shadow: 0 18px 40px -22px rgb(23 18 58 / .35); border-color: var(--color-teal); }
    .fact:hover .fact__icon { transform: translateY(-2px) rotate(-6deg); transition-delay: 0s; }
  }
</style>
