---
// Services in two groups, each led by its doctor (data: serviceGroups in practice.ts). A compact two-column
// checklist on phones; the one-line descriptions stay in the data for a future Services page. No JS.
import Section from '../Section.astro'
import Icon from '../Icon.astro'
import { serviceGroups, doctorBySlug } from '../../data/practice'
---
<Section id="services" tone="white">
  <h2 class="text-[1.9rem] md:text-4xl">Visits and services</h2>
  <p class="mt-2 text-sm text-muted">Sample list for the design demo. The doctors confirm every line before launch.</p>
  <div class="mt-8 space-y-10 md:mt-12 md:grid md:grid-cols-2 md:gap-14 md:space-y-0">
    {serviceGroups.map(g => {
      const doc = doctorBySlug(g.doctor)
      return (
        <div>
          <h3 class="text-xl md:text-2xl">{g.title}</h3>
          {doc && <p class="mt-1 text-[0.95rem] text-muted">With {doc.name} · {doc.ages}</p>}
          <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-4">
            {g.items.map(([name]) => (
              <li class="flex items-start gap-2 text-[0.97rem] font-medium leading-snug text-indigo"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-teal-deep" />{name}</li>
            ))}
          </ul>
        </div>
      )
    })}
  </div>
  <p class="mt-10 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.97rem] md:mt-14 md:text-base">
    <strong class="text-indigo">Feeling unwell?</strong>
    <a href="/locations" data-call class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-teal-deep underline underline-offset-4"><Icon name="phone" size={16} />Call an office</a>
    <span>In an emergency, call 911.</span>
  </p>
</Section>
