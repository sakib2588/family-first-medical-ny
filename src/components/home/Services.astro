---
// Care by age: life stages in order (the reference site's strongest content idea, made ours: one colour, a ranked
// list, no colour-coded ages, no stock thumbnails). Each row names the doctor who leads that stage.
// Data: ageBands in practice.ts (sample; each doctor confirms the ranges).
import Section from '../Section.astro'
import { ageBands, doctorBySlug, practice } from '../../data/practice'
---
<Section id="care" tone="white">
  <div class="md:grid md:grid-cols-[1fr_1.7fr] md:gap-16">
    <div>
      <h2 class="text-[1.9rem] md:text-4xl">Care by age</h2>
      <p class="mt-3 max-w-[34ch] md:text-lg">Your children can stay with the same practice as they grow, then move to adult care with us.</p>
      {practice.demo && <p class="mt-3 text-sm text-muted">Sample ranges and services for the design demo. The doctors confirm every line before launch.</p>}
    </div>
    <ol class="mt-8 divide-y divide-line border-y border-line md:mt-0">
      {ageBands.map(b => {
        const docs = b.doctors.map(doctorBySlug).filter(d => d !== undefined)
        return (
          <li class="grid grid-cols-[6.5rem_1fr] gap-4 py-5 md:grid-cols-[9rem_1fr] md:gap-8">
            <p class="font-display text-lg font-semibold leading-tight text-indigo md:text-xl">{b.range}</p>
            <div>
              <h3 class="font-sans text-base font-semibold text-indigo md:text-lg">{b.title}</h3>
              <p class="mt-1 text-[0.95rem] text-muted">{b.line}</p>
              <p class="mt-1 text-[0.95rem]">With {docs.map((d, i) => (<>{i > 0 && ' or '}<a href={`/doctors/${d.slug}`} class="inline-flex min-h-11 items-center font-medium text-indigo underline underline-offset-4">{d.name}</a></>))}</p>
            </div>
          </li>
        )
      })}
    </ol>
  </div>
</Section>
