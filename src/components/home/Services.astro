---
import Section from '../Section.astro'
const groups = [
  { title: 'For children and teens', items: ['Well-child visits', 'Newborn care', 'Vaccinations', 'School and sports physicals', 'Developmental screening'] },
  { title: 'For adults', items: ['Annual physicals', 'Chronic condition care', 'Women\'s health', 'Preventive screenings'] },
]
---
<Section id="services" tone="lavender">
  <span class="mb-4 block h-1 w-10 rounded-full bg-gold" aria-hidden="true"></span>
  <h2 class="text-[1.9rem] md:text-4xl">Comprehensive care, every visit</h2>
  <div class="mt-8 space-y-9 md:mt-12 md:grid md:grid-cols-2 md:gap-16 md:space-y-0">
    {groups.map(g => (
      <div>
        <h3 class="text-lg md:text-xl">{g.title}</h3>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {g.items.map(i => (<li class="flex min-h-12 items-center text-[1.02rem] text-indigo md:text-lg">{i}</li>))}
        </ul>
      </div>
    ))}
  </div>
  <p class="mt-8 rounded-2xl bg-white p-5 text-[0.97rem] md:mt-12 md:max-w-xl md:text-base"><strong class="text-indigo">Feeling unwell?</strong> We hold room for same-day sick visits. Call the office and we will find a time.</p>
</Section>
