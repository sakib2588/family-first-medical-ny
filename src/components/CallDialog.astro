---
// "Call which office?" Native <dialog>: Escape closes it, focus is trapped and restored by the browser.
// Without JS every [data-call] link falls back to its href (/locations), which lists both numbers.
import { offices, telHref } from '../data/practice'
---
<dialog id="call-dialog" aria-labelledby="call-title" class="m-auto w-[min(92vw,26rem)] rounded-3xl border-0 bg-white p-6 text-text shadow-[0_24px_60px_-20px_rgb(23_18_58/0.5)] backdrop:bg-indigo/50">
  <h2 id="call-title" class="text-2xl">Call which office?</h2>
  <ul class="mt-4 space-y-3">
    {offices.map(o => (
      <li><a href={telHref(o.phone)} class="btn flex min-h-14 items-center justify-between rounded-2xl bg-teal-deep px-5 text-white hover:bg-teal-darker">
        <span class="font-semibold">{o.neighborhood.split(',')[0]}</span><span class="tabular text-[1.05rem]">{o.phone}</span>
      </a></li>
    ))}
  </ul>
  <p class="mt-4 text-sm text-muted">In an emergency, call 911.</p>
  <form method="dialog"><button class="btn mt-3 inline-flex min-h-12 w-full items-center justify-center rounded-full border-2 border-line font-semibold text-indigo hover:border-indigo">Cancel</button></form>
</dialog>
<script>
  const dialog = document.getElementById('call-dialog') as HTMLDialogElement | null
  if (dialog && typeof dialog.showModal === 'function') {
    document.querySelectorAll('[data-call]').forEach(a => a.addEventListener('click', e => { e.preventDefault(); dialog.showModal() }))
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close() })
  }
</script>
