---
// "Call which office?" (spec 4.16). Native <dialog>: Escape and a backdrop click close it; focus returns to the
// opener. Phone: a bottom sheet; desktop: centred, 440 wide, numbers shown as text. Rows are outlined, not filled
// (one filled action). Without JS every [data-call] link falls back to its href (/locations), which lists both numbers.
import OpenNow from './OpenNow.astro'
import { offices, telHref } from '../data/practice'
---
<dialog id="call-dialog" aria-labelledby="call-title" class="sheet mx-0 mb-0 mt-auto w-full max-w-none rounded-t-[1.75rem] border-0 bg-white px-5 pb-[calc(1.5rem+env(safe-area-inset-bottom))] pt-6 text-text shadow-dialog backdrop:bg-indigo/50 lg:m-auto lg:w-[440px] lg:rounded-[1.75rem] lg:p-6">
  <h2 id="call-title" class="text-[1.29rem]">Call which office?</h2>
  <ul class="mt-4 space-y-3">
    {offices.map(o => (
      <li><a href={telHref(o.phone)} class="flex min-h-[4.5rem] items-center justify-between gap-3 rounded-[1.25rem] border border-line px-4 py-2 hover:border-teal-deep">
        <span><span class="block font-semibold text-indigo">{o.neighborhood.split(',')[0]}</span><OpenNow office={o} fallback="See hours" class="block text-[0.82rem] leading-snug text-muted" /></span>
        <span class="tabular whitespace-nowrap font-semibold text-teal-deep">{o.phone}</span>
      </a></li>
    ))}
  </ul>
  <p class="mt-4 text-[0.88rem]">In an emergency, call 911.</p>
  <form method="dialog"><button class="btn mt-2 inline-flex min-h-12 w-full items-center justify-center rounded-full font-semibold text-indigo underline underline-offset-4">Cancel</button></form>
</dialog>
<script>
  const dialog = document.getElementById('call-dialog') as HTMLDialogElement | null
  if (dialog && typeof dialog.showModal === 'function') {
    document.querySelectorAll('[data-call]').forEach(a => a.addEventListener('click', e => { e.preventDefault(); dialog.showModal() }))
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close() })
  }
</script>
